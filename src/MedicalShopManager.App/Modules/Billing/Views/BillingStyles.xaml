<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:MedicalShopManager.Core.Modules.Billing;assembly=MedicalShopManager.Core">

    <!-- Billing module styles (merged by the Billing views; built on the shared Theme.xaml brushes). -->

    <Style x:Key="BillingLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="BillingValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="BillingField" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,10,8"/>
    </Style>

    <Style x:Key="BillingKeyHint" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="BillingKeyHintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <Style x:Key="BillingPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource InfoBgBrush}"/>
    </Style>

    <!-- Dialog card on the dim overlay -->
    <Style x:Key="BillingDialogCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BillingErrorList" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,6,0,6"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,1"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BillingTotalLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="BillingTotalValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="BillingLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextLinkBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Bill grid rows: red when the batch is expired, orange when expiring (spec 02 legend) -->
    <Style x:Key="BillingLineRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ExpiryState}" Value="{x:Static core:BatchExpiryState.NearExpiry}">
                <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ExpiryState}" Value="{x:Static core:BatchExpiryState.Expired}">
                <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Batch popup rows: unsellable batches red, near expiry orange -->
    <Style x:Key="BillingBatchRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNearExpiry}" Value="True">
                <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSellable}" Value="False">
                <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Editable numeric cell inside the bill grid -->
    <Style x:Key="BillingCellBox" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="MinWidth" Value="40"/>
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

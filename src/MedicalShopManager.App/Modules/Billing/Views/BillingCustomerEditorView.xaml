<UserControl x:Class="MedicalShopManager.App.Modules.Billing.Views.BillingCustomerEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.Billing.ViewModels"
             xmlns:views="clr-namespace:MedicalShopManager.App.Modules.Billing.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BillingCustomerEditorViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BillingStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </UserControl.InputBindings>

    <Border Style="{StaticResource BillingDialogCard}" Width="760" views:BillingFocus.FocusFirstOnShow="True">
        <StackPanel views:BillingFocus.KeyboardForm="True">
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save (F2)" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0" IsTabStop="False"/>
                    <Button Content="✕" Command="{Binding CloseCommand}" Style="{StaticResource BillingLinkButton}" IsTabStop="False" ToolTip="Close (Esc)"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <TextBlock Text="Fill in the details below to add" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>

            <CheckBox Content="CUSTOMER IS A BUSINESS (B2B, with GSTIN)" IsChecked="{Binding IsBusiness}" Margin="0,0,0,10" TabIndex="0"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource BillingField}">
                    <TextBlock Text="CUSTOMER'S NAME *" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="120" TabIndex="1"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource BillingField}">
                    <TextBlock Text="MOBILE NUMBER (10 digits)" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="10" TabIndex="2"/>
                </StackPanel>

                <!-- Individual -->
                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource BillingField}" Visibility="{Binding IsBusiness, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="GENDER" Style="{StaticResource BillingLabel}"/>
                    <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}" TabIndex="3"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource BillingField}" Visibility="{Binding IsBusiness, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="DATE OF BIRTH" Style="{StaticResource BillingLabel}"/>
                    <DatePicker SelectedDate="{Binding DateOfBirth}" TabIndex="4"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource BillingField}" Visibility="{Binding IsBusiness, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="CUSTOMER'S AGE (yrs / mos)" Style="{StaticResource BillingLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding AgeYears, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Style="{StaticResource ModernTextBox}" Width="60" TabIndex="5"/>
                        <TextBlock Text=" yrs " VerticalAlignment="Center"/>
                        <TextBox Text="{Binding AgeMonths, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Style="{StaticResource ModernTextBox}" Width="50" TabIndex="6"/>
                        <TextBlock Text=" mos" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Business -->
                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource BillingField}" Visibility="{Binding IsBusiness, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="CUSTOMER'S GSTIN (15)" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="15"
                             CharacterCasing="Upper" TabIndex="3"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource BillingField}" Visibility="{Binding IsBusiness, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="PAN NUMBER" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding Pan, Mode=OneWay, TargetNullValue='PAN will appear here'}" IsReadOnly="True" IsTabStop="False" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource BillingField}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsBusiness, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="TAXPAYER TYPE" Style="{StaticResource BillingLabel}"/>
                    <CheckBox Content="Composition Dealer" IsChecked="{Binding IsCompositionDealer}" TabIndex="4"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource BillingField}">
                    <TextBlock Text="SALES DISCOUNT %" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" Style="{StaticResource ModernTextBox}" TabIndex="7"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource BillingField}">
                    <TextBlock Text="CREDIT DAYS" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding CreditDays, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBox}" TabIndex="8"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource BillingField}">
                    <TextBlock Text="REFERENCE NO" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding ReferenceNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" TabIndex="9"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource BillingField}">
                    <TextBlock Text="CUSTOMER'S ADDRESS" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" TabIndex="10"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Style="{StaticResource BillingField}">
                    <TextBlock Text="EMAIL" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" TabIndex="11"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Style="{StaticResource BillingField}">
                    <TextBlock Text="OPENING BALANCE ₹ (+ to receive)" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding OpeningBalance, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" Style="{StaticResource ModernTextBox}" TabIndex="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource BillingField}">
                    <TextBlock Text="OPENING BAL DATE" Style="{StaticResource BillingLabel}"/>
                    <DatePicker SelectedDate="{Binding OpeningBalanceDate}" TabIndex="13"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource BillingField}">
                    <TextBlock Text="USUAL DOCTOR" Style="{StaticResource BillingLabel}"/>
                    <TextBox Text="{Binding DoctorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" TabIndex="14"/>
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Errors}" Style="{StaticResource BillingErrorList}"
                          Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="Save - F2 | Next field - Enter | Back - Shift + Tab | Close - ESC" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
        </StackPanel>
    </Border>
</UserControl>

<UserControl x:Class="MedicalShopManager.App.Modules.Billing.Views.BillingCustomerPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.Billing.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BillingCustomerPickerViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BillingStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <!-- Select a Customer -->
        <Border Style="{StaticResource BillingDialogCard}" Width="900" MaxHeight="560"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource InverseBoolToVisibility}}">
            <Border.InputBindings>
                <KeyBinding Key="F2" Command="{Binding CreateNewCommand}"/>
                <KeyBinding Key="F4" Command="{Binding EditSelectedCommand}"/>
            </Border.InputBindings>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Create New (F2)" Style="{StaticResource PrimaryButton}" Command="{Binding CreateNewCommand}" Margin="0,0,8,0" IsTabStop="False"/>
                        <Button Content="✕" Command="{Binding CloseCommand}" Style="{StaticResource BillingLinkButton}" IsTabStop="False" ToolTip="Close (Esc)"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Select a Customer" Style="{StaticResource SectionHeader}" Margin="0"/>
                        <TextBlock Text="Select an option from the below list" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </DockPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,8" ToolTip="Search customer by name, mobile or GSTIN">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SelectCommand}" CommandParameter="{Binding SelectedCustomer}"/>
                        <KeyBinding Key="Down" Command="{Binding MoveSelectionCommand}" CommandParameter="Down"/>
                        <KeyBinding Key="Up" Command="{Binding MoveSelectionCommand}" CommandParameter="Up"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock DockPanel.Dock="Bottom" Text="Create New - F2 | EDIT Selected - F4 | Delete Selected - DEL | Close - ESC | Arrow keys + Enter to select"
                           FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,8,0,0"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"
                           Visibility="{Binding Message, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                <Grid>
                    <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedCustomer}" Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="OnRowDoubleClick">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SelectCommand}" CommandParameter="{Binding SelectedCustomer}"/>
                            <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="CUSTOMER'S NAME / ADDRESS" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Address}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="TYPE" Binding="{Binding KindLabel}" Width="80"/>
                            <DataGridTextColumn Header="MOBILE NO" Binding="{Binding Phone}" Width="105"/>
                            <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="130"/>
                            <DataGridTextColumn Header="DISC %" Binding="{Binding DefaultDiscountPercent, StringFormat=0.##}" Width="55"/>
                            <DataGridTextColumn Header="BALANCE" Binding="{Binding BalanceLabel}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="No customer matches your search" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="{Binding CreateNewLabel}" Style="{StaticResource BillingLinkButton}" Command="{Binding CreateNewCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Add / edit customer -->
        <ContentControl Content="{Binding Editor}" ContentTemplateSelector="{StaticResource ViewLocator}" IsTabStop="False"
                        Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>

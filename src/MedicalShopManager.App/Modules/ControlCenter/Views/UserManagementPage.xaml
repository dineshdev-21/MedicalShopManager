<UserControl x:Class="MedicalShopManager.App.Modules.ControlCenter.Views.UserManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.ControlCenter.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UserManagementViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MedicalShopManager;component/Modules/ControlCenter/Views/ControlCenterStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenCreateUserModalCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveUserCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseModalsCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="+ New user (Ctrl+N)" Command="{Binding OpenCreateUserModalCommand}"
                            Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0"/>
                    <TextBlock Text="Users &amp; Permissions" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Style="{StaticResource CcHint}" Margin="0,0,0,12">
                    <Run Text="This device:"/> <Run Text="{Binding DeviceName, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="   Signed in as:"/> <Run Text="{Binding SignedInAs, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <Border Style="{StaticResource CcSuccessBanner}" Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
                <Border Style="{StaticResource CcErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Users list -->
                    <Border Style="{StaticResource CardStyle}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Users" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Style="{StaticResource ModernDataGrid}"
                                      IsReadOnly="True" SelectionMode="Single" AutoGenerateColumns="False" MaxHeight="420">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.3*"/>
                                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55"/>
                                    <DataGridTextColumn Header="Last login" Binding="{Binding LastLoginAt, StringFormat=dd-MMM-yy HH:mm}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Selected user -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                        <Grid>
                            <TextBlock Text="Select a user to edit their details and permissions." Style="{StaticResource CcHint}"
                                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedUser.Username, StringFormat=User: {0}}" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Style="{StaticResource CcField}">
                                        <TextBlock Text="Display name" Style="{StaticResource CcFieldLabel}"/>
                                        <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="60"/>
                                        <TextBlock Text="{Binding Errors[DisplayName]}" Style="{StaticResource CcFieldError}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CcField}">
                                        <TextBlock Text="Role" Style="{StaticResource CcFieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding EditRole}" Style="{StaticResource CcCombo}"/>
                                        <TextBlock Text="{Binding Errors[Role]}" Style="{StaticResource CcFieldError}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CcField}">
                                        <TextBlock Text="Status" Style="{StaticResource CcFieldLabel}"/>
                                        <CheckBox Content="Active (can sign in)" IsChecked="{Binding EditIsActive}" Style="{StaticResource CcCheckBox}"/>
                                        <TextBlock Text="{Binding Errors[User]}" Style="{StaticResource CcFieldError}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="Save user (Ctrl+S)" Command="{Binding SaveUserCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                                    <Button Content="Reset password..." Command="{Binding OpenResetPasswordModalCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,0"/>
                                    <Button Content="Permissions = role defaults" Command="{Binding ResetPermissionsToRoleCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0"
                                            IsEnabled="{Binding IsPermissionMatrixEditable}"/>
                                </StackPanel>

                                <TextBlock Text="Permissions" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding PermissionNote}" Style="{StaticResource CcHint}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding PermissionGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="230" Margin="0,0,12,12">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,2"/>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsPermitted}" IsEnabled="{Binding IsEditable}"
                                                                      Style="{StaticResource CcCheckBox}" Margin="0,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Audit trail -->
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Audit trail (latest 100)" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Text="No activity recorded yet." Style="{StaticResource CcHint}"
                                   Visibility="{Binding HasAuditLogs, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <DataGrid ItemsSource="{Binding AuditLogs}" Style="{StaticResource ModernDataGrid}" MaxHeight="320"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  Visibility="{Binding HasAuditLogs, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=dd-MMM-yyyy HH:mm:ss}" Width="150"/>
                                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="220" Foreground="{StaticResource PrimaryBrush}"/>
                                <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="110"/>
                                <DataGridTextColumn Header="Record" Binding="{Binding EntityId}" Width="70"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Reason}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Create user dialog -->
        <Grid Style="{StaticResource CcModalOverlay}" Visibility="{Binding IsCreateUserModalOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20"
                    Background="{StaticResource CardBrush}" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="New user" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                    <StackPanel Style="{StaticResource CcField}">
                        <TextBlock Text="Username * (used to sign in)" Style="{StaticResource CcFieldLabel}"/>
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="32"/>
                        <TextBlock Text="{Binding Errors[Username]}" Style="{StaticResource CcFieldError}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource CcField}">
                        <TextBlock Text="Display name *" Style="{StaticResource CcFieldLabel}"/>
                        <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="60"/>
                        <TextBlock Text="{Binding Errors[DisplayName]}" Style="{StaticResource CcFieldError}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource CcField}">
                        <TextBlock Text="Temporary password * (min 6 characters)" Style="{StaticResource CcFieldLabel}"/>
                        <PasswordBox x:Name="NewPasswordBox" PasswordChanged="NewPasswordBox_PasswordChanged" Height="34" Padding="8,0" VerticalContentAlignment="Center" MaxLength="64"/>
                        <TextBlock Text="{Binding Errors[Password]}" Style="{StaticResource CcFieldError}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource CcField}">
                        <TextBlock Text="Role *" Style="{StaticResource CcFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding NewRole}" Style="{StaticResource CcCombo}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel (Esc)" Command="{Binding CloseModalsCommand}" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                        <Button Content="Create user" Command="{Binding CreateUserCommand}" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Reset password dialog -->
        <Grid Style="{StaticResource CcModalOverlay}" Visibility="{Binding IsResetPasswordModalOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20"
                    Background="{StaticResource CardBrush}" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedUser.Username, StringFormat=Reset password: {0}}" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                    <StackPanel Style="{StaticResource CcField}">
                        <TextBlock Text="New password (min 6 characters)" Style="{StaticResource CcFieldLabel}"/>
                        <PasswordBox x:Name="ResetPasswordBox" PasswordChanged="ResetPasswordBox_PasswordChanged" Height="34" Padding="8,0" VerticalContentAlignment="Center" MaxLength="64"/>
                        <TextBlock Text="{Binding Errors[Password]}" Style="{StaticResource CcFieldError}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel (Esc)" Command="{Binding CloseModalsCommand}" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                        <Button Content="Change password" Command="{Binding ConfirmResetPasswordCommand}" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

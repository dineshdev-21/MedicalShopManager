<UserControl x:Class="MedicalShopManager.App.Modules.ControlCenter.Views.ControlCenterHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.ControlCenter.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ControlCenterHomeViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MedicalShopManager;component/Modules/ControlCenter/Views/ControlCenterStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="D1" Modifiers="Alt" Command="{Binding OpenCommand}" CommandParameter="BusinessProfile"/>
        <KeyBinding Key="D2" Modifiers="Alt" Command="{Binding OpenCommand}" CommandParameter="SaleSettings"/>
        <KeyBinding Key="D3" Modifiers="Alt" Command="{Binding OpenCommand}" CommandParameter="PrefixSequences"/>
        <KeyBinding Key="D4" Modifiers="Alt" Command="{Binding OpenCommand}" CommandParameter="PrintLayout"/>
        <KeyBinding Key="D5" Modifiers="Alt" Command="{Binding OpenCommand}" CommandParameter="UserManagement"/>
        <KeyBinding Key="D6" Modifiers="Alt" Command="{Binding OpenCommand}" CommandParameter="Settings"/>
        <KeyBinding Key="D7" Modifiers="Alt" Command="{Binding OpenCommand}" CommandParameter="Backup"/>
        <KeyBinding Key="D8" Modifiers="Alt" Command="{Binding OpenCommand}" CommandParameter="ExcelManagement"/>
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Control Center" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Shop identity, numbering, printing, sale rules, users and data tools. Press Alt + 1 to 8 to jump to a section."
                       Style="{StaticResource CcHint}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource CcErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- Set-up checklist -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding SetupWarnings.Count, Converter={StaticResource CountToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Finish setting up your invoices" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding SetupWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=• {0}}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CcSuccessBanner}" Visibility="{Binding IsSetupComplete, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Business profile is complete: invoices carry your GSTIN, drug licences and pharmacist details."
                           Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
            </Border>

            <!-- Tiles -->
            <ItemsControl ItemsSource="{Binding Tiles}" KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="300" Height="112" Margin="0,0,12,12" Padding="14" Cursor="Hand"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding PageKey}"
                                ToolTip="{Binding Shortcut}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CcHint}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

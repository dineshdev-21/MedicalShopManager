<UserControl x:Class="MedicalShopManager.App.Modules.ControlCenter.Views.PrintLayoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.ControlCenter.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrintLayoutViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MedicalShopManager;component/Modules/ControlCenter/Views/ControlCenterStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PreviewCommand}"/>
    </UserControl.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="0,10,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Discard changes" Command="{Binding DiscardChangesCommand}" Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0" Margin="0,0,8,0"/>
                <Button Content="Preview sale invoice (Ctrl+P)" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0" Margin="0,0,8,0"/>
                <Button Content="Save print layout (Ctrl+S)" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Height="36" Padding="20,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,8">
            <TextBlock Text="Print Layout" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Choose the paper each document prints on and which details appear on invoices. Laser / inkjet: A4 or A5; thermal receipt printers: 80 mm or 58 mm."
                       Style="{StaticResource CcHint}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CcSuccessBanner}" Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource CcErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- Paper sizes -->
            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Paper size per document" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                    <TextBlock Text="No printable documents are registered yet." Style="{StaticResource CcHint}"
                               Visibility="{Binding HasTemplates, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Templates}" KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SupportedSizes}" SelectedItem="{Binding SelectedSize}" Style="{StaticResource CcCombo}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DefaultLabel}" Style="{StaticResource CcHint}" VerticalAlignment="Center" Margin="12,0"/>
                                    <Button Grid.Column="3" Content="Preview" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0"
                                            Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanPreview, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Invoice fields -->
            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Tick all" Command="{Binding SetAllFieldsCommand}" CommandParameter="on" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="0,0,6,0"/>
                            <Button Content="Untick all" Command="{Binding SetAllFieldsCommand}" CommandParameter="off" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="0,0,6,0"/>
                            <Button Content="Defaults" Command="{Binding ResetFieldsToDefaultsCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0"/>
                        </StackPanel>
                        <TextBlock Text="Details printed on sale invoices" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding FieldGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="260" Margin="0,0,16,12">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" ToolTip="{Binding Hint}"
                                                          Style="{StaticResource CcCheckBox}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Terms and conditions" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding TermsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalContentAlignment="Top" MaxLength="500"/>
                            <TextBlock Text="{Binding Errors[TermsText]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Style="{StaticResource CcField}">
                                <TextBlock Text="Footer note" Style="{StaticResource CcFieldLabel}"/>
                                <TextBox Text="{Binding FooterNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="200"/>
                                <TextBlock Text="{Binding Errors[FooterNote]}" Style="{StaticResource CcFieldError}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource CcField}">
                                <TextBlock Text="Invoice contact number (blank = shop phone)" Style="{StaticResource CcFieldLabel}"/>
                                <TextBox Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="20"/>
                                <TextBlock Text="{Binding Errors[ContactNumber]}" Style="{StaticResource CcFieldError}"/>
                            </StackPanel>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Bank details and the UPI QR come from the Business Profile." Style="{StaticResource CcHint}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</UserControl>

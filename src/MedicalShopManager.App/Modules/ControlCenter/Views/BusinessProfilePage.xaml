<UserControl x:Class="MedicalShopManager.App.Modules.ControlCenter.Views.BusinessProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.ControlCenter.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BusinessProfileViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MedicalShopManager;component/Modules/ControlCenter/Views/ControlCenterStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom" Padding="0,10,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Discard changes" Command="{Binding DiscardChangesCommand}" Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0" Margin="0,0,8,0"/>
                <Button Content="Save profile (Ctrl+S)" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Height="36" Padding="20,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,8">
            <TextBlock Text="Business Profile" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Printed on every invoice. The state decides CGST + SGST or IGST; the GST registration decides Tax Invoice or Bill of Supply."
                       Style="{StaticResource CcHint}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CcSuccessBanner}" Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource CcErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- Shop & address -->
            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Shop and address" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Shop name *" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="100"/>
                            <TextBlock Text="{Binding Errors[ShopName]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Legal / trade name (GST records)" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="100"/>
                            <TextBlock Text="{Binding Errors[LegalName]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Phone" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="20"/>
                            <TextBlock Text="{Binding Errors[Phone]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Address line 1" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="120"/>
                            <TextBlock Text="{Binding Errors[AddressLine1]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Address line 2" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="120"/>
                            <TextBlock Text="{Binding Errors[AddressLine2]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="City / town" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="60"/>
                            <TextBlock Text="{Binding Errors[City]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="PIN code" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="6"/>
                            <TextBlock Text="{Binding Errors[Pincode]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="State *" Style="{StaticResource CcFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" DisplayMemberPath="Display"
                                      Style="{StaticResource CcCombo}" IsEditable="False"/>
                            <TextBlock Text="{Binding Errors[StateCode]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Email" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="100"/>
                            <TextBlock Text="{Binding Errors[Email]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- GST -->
            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="GST registration" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Registration type *" Style="{StaticResource CcFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding RegistrationTypes}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                      SelectedValue="{Binding GstRegistrationType}" Style="{StaticResource CcCombo}"/>
                            <TextBlock Text="{Binding Errors[GstRegistrationType]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="GSTIN (15 characters)" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="15" CharacterCasing="Upper" IsEnabled="{Binding IsGstinRequired}"/>
                            <TextBlock Text="{Binding Errors[Gstin]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="PAN" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding Pan, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="10" CharacterCasing="Upper"/>
                            <TextBlock Text="{Binding Errors[Pan]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                    </UniformGrid>
                    <Border Background="{StaticResource InfoBgBrush}" CornerRadius="4" Padding="10,6">
                        <TextBlock Text="{Binding TaxRegimeHint}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Licences & pharmacist -->
            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Drug licences and pharmacist" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Drug licence Form 20B" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding DrugLicense20B, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="40"/>
                            <TextBlock Text="{Binding Errors[DrugLicense20B]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Drug licence Form 21B" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding DrugLicense21B, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="40"/>
                            <TextBlock Text="{Binding Errors[DrugLicense21B]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Licence valid till" Style="{StaticResource CcFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding DrugLicenseExpiry}" Height="34" SelectedDateFormat="Short"/>
                            <TextBlock Text="{Binding Errors[DrugLicenseExpiry]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="FSSAI number (14 digits)" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding Fssai, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="14"/>
                            <TextBlock Text="{Binding Errors[Fssai]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Registered pharmacist name" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding PharmacistName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="100"/>
                            <TextBlock Text="{Binding Errors[PharmacistName]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Pharmacist registration no." Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding PharmacistRegistrationNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="40"/>
                            <TextBlock Text="{Binding Errors[PharmacistRegistrationNo]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Bank & UPI -->
            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Bank and UPI (for the invoice payment QR)" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="UPI ID" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding UpiId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="100"/>
                            <TextBlock Text="e.g. myshop@okaxis" Style="{StaticResource CcHint}"/>
                            <TextBlock Text="{Binding Errors[UpiId]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Bank name" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="60"/>
                            <TextBlock Text="{Binding Errors[BankName]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Account holder name" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding BankAccountName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="100"/>
                            <TextBlock Text="{Binding Errors[BankAccountName]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Account number" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding BankAccountNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="18"/>
                            <TextBlock Text="{Binding Errors[BankAccountNumber]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="IFSC" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding BankIfsc, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="11" CharacterCasing="Upper"/>
                            <TextBlock Text="{Binding Errors[BankIfsc]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CcField}">
                            <TextBlock Text="Branch" Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding BankBranch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="60"/>
                            <TextBlock Text="{Binding Errors[BankBranch]}" Style="{StaticResource CcFieldError}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Logo & signature -->
            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Logo and signature" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBlock Text="PNG or JPEG, up to 512 KB. Saved immediately and stored inside the database, so backups include them."
                               Style="{StaticResource CcHint}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Shop logo" Style="{StaticResource CcFieldLabel}"/>
                            <Border Height="110" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                                <Grid>
                                    <Image Source="{Binding LogoPreview}" Stretch="Uniform" Margin="6"/>
                                    <TextBlock Text="No logo" Style="{StaticResource CcHint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasLogo, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose logo..." Command="{Binding ChooseLogoCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,0"/>
                                <Button Content="Remove" Command="{Binding RemoveLogoCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0"
                                        IsEnabled="{Binding HasLogo}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Authorised signature" Style="{StaticResource CcFieldLabel}"/>
                            <Border Height="110" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                                <Grid>
                                    <Image Source="{Binding SignaturePreview}" Stretch="Uniform" Margin="6"/>
                                    <TextBlock Text="No signature" Style="{StaticResource CcHint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasSignature, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose signature..." Command="{Binding ChooseSignatureCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,0"/>
                                <Button Content="Remove" Command="{Binding RemoveSignatureCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0"
                                        IsEnabled="{Binding HasSignature}"/>
                            </StackPanel>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</UserControl>

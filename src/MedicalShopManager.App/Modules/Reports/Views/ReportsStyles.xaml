<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Reports module styles (merged by the Reports views; built on the shared Theme.xaml brushes). -->

    <Style x:Key="RptLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="RptValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="RptHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RptField" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,12,8"/>
    </Style>

    <Style x:Key="RptInput" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RptPresetButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="RptStarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style x:Key="RptFigure" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="MinWidth" Value="130"/>
    </Style>

    <Style x:Key="RptCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="RptSheetTab" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Opening / subtotal rows of a report grid are bold (hidden __style column: 1 = opening, 2 = subtotal). -->
    <Style x:Key="RptGridRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding [__style]}" Value="1">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Background" Value="{StaticResource InfoBgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding [__style]}" Value="2">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

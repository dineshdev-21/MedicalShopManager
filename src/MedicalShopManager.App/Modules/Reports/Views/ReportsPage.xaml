<UserControl x:Class="MedicalShopManager.App.Modules.Reports.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.Reports.ViewModels"
             xmlns:local="clr-namespace:MedicalShopManager.App.Modules.Reports.Views"
             mc:Ignorable="d"
             Loaded="OnLoaded"
             d:DataContext="{d:DesignInstance Type=vm:ReportsViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ReportsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding ToggleFavouriteCommand}"/>
        <KeyBinding Key="F3" Command="{x:Static local:ReportsFocusCommands.FocusSearch}"/>
    </UserControl.InputBindings>
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static local:ReportsFocusCommands.FocusSearch}" Executed="OnFocusSearch"/>
    </UserControl.CommandBindings>

    <DockPanel Margin="0,0,8,0">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Business Reports" Style="{StaticResource PageTitle}" Margin="0"/>
            <TextBlock Text="GST returns, registers, stock, profit and party reports. Type to search · ↓ to the list · Enter opens · Ctrl+D favourite · F3 search"
                       Style="{StaticResource RptHint}"/>
        </StackPanel>

        <!-- Search -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" Style="{StaticResource RptHint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RptInput}"
                         TabIndex="0" PreviewKeyDown="OnSearchKeyDown"
                         ToolTip="Search reports by name or keyword, e.g. GSTR, H1, expiry, profit">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding OpenReportCommand}"/>
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- Status -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <!-- Categories -->
        <Border DockPanel.Dock="Left" Style="{StaticResource CardStyle}" Padding="6" Margin="0,0,10,0" Width="200">
            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label"
                     BorderThickness="0" Background="Transparent" TabIndex="2" KeyboardNavigation.TabNavigation="Once"/>
        </Border>

        <!-- Reports -->
        <Grid>
            <ListBox x:Name="ReportList" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" TabIndex="1"
                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Once">
                <ListBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding OpenReportCommand}"/>
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportCardItem}">
                        <Border Style="{StaticResource RptCard}" Margin="0,0,0,6" Background="Transparent">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick"
                                              Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="{Binding StarGlyph}" Style="{StaticResource RptStarButton}" VerticalAlignment="Top"
                                        ToolTip="Add to / remove from favourites (Ctrl+D)"
                                        Command="{Binding DataContext.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button DockPanel.Dock="Right" Content="Open ›" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0"
                                        VerticalAlignment="Center" Focusable="False"
                                        Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <StackPanel Margin="6,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border Background="{StaticResource InfoBgBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="10" Foreground="{StaticResource InfoBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource RptHint}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="☆" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource RptHint}" FontSize="13" TextAlignment="Center" MaxWidth="420"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

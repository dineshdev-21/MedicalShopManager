<UserControl x:Class="MedicalShopManager.App.Modules.Purchases.Views.PurchaseDistributorEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.Purchases.ViewModels"
             xmlns:local="clr-namespace:MedicalShopManager.App.Modules.Purchases.Views"
             mc:Ignorable="d"
             local:PurchasesFocus.KeyboardForm="True"
             d:DataContext="{d:DesignInstance Type=vm:PurchaseDistributorEditorViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PurchasesStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource PurchaseField}">
                <TextBlock Text="DISTRIBUTOR NAME *" Style="{StaticResource PurchaseLabel}"/>
                <TextBox Text="{Binding Name}" Style="{StaticResource PurchaseInput}" MaxLength="120"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource PurchaseField}">
                <TextBlock Text="GSTIN" Style="{StaticResource PurchaseLabel}"/>
                <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PurchaseInput}" MaxLength="15" CharacterCasing="Upper"
                         ToolTip="15 characters, e.g. 29ABCDE1234F1Z5; fills the state"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource PurchaseField}">
                <TextBlock Text="DRUG LICENCE NO (20B / 21B)" Style="{StaticResource PurchaseLabel}"/>
                <TextBox Text="{Binding DrugLicenseNumber}" Style="{StaticResource PurchaseInput}" MaxLength="60" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource PurchaseField}">
                <TextBlock Text="PHONE" Style="{StaticResource PurchaseLabel}"/>
                <TextBox Text="{Binding Phone}" Style="{StaticResource PurchaseInput}" MaxLength="20"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource PurchaseField}">
                <TextBlock Text="CONTACT PERSON" Style="{StaticResource PurchaseLabel}"/>
                <TextBox Text="{Binding ContactPerson}" Style="{StaticResource PurchaseInput}" MaxLength="80"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource PurchaseField}">
                <TextBlock Text="ADDRESS" Style="{StaticResource PurchaseLabel}"/>
                <TextBox Text="{Binding Address}" Style="{StaticResource PurchaseInput}" MaxLength="250"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource PurchaseField}">
                <TextBlock Text="STATE" Style="{StaticResource PurchaseLabel}"/>
                <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" DisplayMemberPath="Label" Height="30" IsEditable="False"/>
            </StackPanel>
            <Grid Grid.Row="4" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource PurchaseField}">
                    <TextBlock Text="PINCODE" Style="{StaticResource PurchaseLabel}"/>
                    <TextBox Text="{Binding Pincode}" Style="{StaticResource PurchaseInput}" MaxLength="6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource PurchaseField}">
                    <TextBlock Text="CREDIT DAYS" Style="{StaticResource PurchaseLabel}"/>
                    <TextBox Text="{Binding CreditDays}" Style="{StaticResource PurchaseNumberInput}"
                             ToolTip="Payment due date = invoice date + these days"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="5" Grid.Column="0" Style="{StaticResource PurchaseField}">
                <TextBlock Text="EMAIL" Style="{StaticResource PurchaseLabel}"/>
                <TextBox Text="{Binding Email}" Style="{StaticResource PurchaseInput}" MaxLength="120"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.Column="1" Style="{StaticResource PurchaseField}">
                <TextBlock Text="OPENING BALANCE ₹ (you owe)" Style="{StaticResource PurchaseLabel}"/>
                <TextBox Text="{Binding OpeningBalance}" Style="{StaticResource PurchaseNumberInput}"/>
            </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding Errors}" Style="{StaticResource PurchaseErrorList}"/>
    </StackPanel>
</UserControl>

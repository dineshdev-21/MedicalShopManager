<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Purchases module styles (merged by the Purchases views; built on the shared Theme.xaml brushes). -->

    <Style x:Key="PurchaseLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="PurchaseValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="PurchaseField" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,10,8"/>
    </Style>

    <Style x:Key="PurchaseInput" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PurchaseNumberInput" TargetType="TextBox" BasedOn="{StaticResource PurchaseInput}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="PurchaseKeyHint" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="PurchaseKeyHintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <Style x:Key="PurchasePill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource InfoBgBrush}"/>
    </Style>

    <!-- Dialog card on the dim overlay -->
    <Style x:Key="PurchaseDialogCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PurchaseOverlay" TargetType="Grid">
        <Setter Property="Background" Value="#80000000"/>
    </Style>

    <Style x:Key="PurchaseErrorList" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,6,0,6"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,1"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PurchaseTotalLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,2,12,2"/>
    </Style>

    <Style x:Key="PurchaseTotalValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="PurchaseEmptyTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="PurchaseEmptyHint" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
    </Style>

    <!-- Row colouring of batches: red = expired, orange = expiring (spec 04 legend). -->
    <Style x:Key="PurchaseExpiryRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNearExpiry}" Value="True">
                <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PurchaseStatusRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusLabel}" Value="Overdue">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusLabel}" Value="Cancelled">
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusLabel}" Value="Draft">
                <Setter Property="FontStyle" Value="Italic"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

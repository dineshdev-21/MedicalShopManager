<UserControl x:Class="MedicalShopManager.App.Modules.Purchases.Views.PurchaseEntryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.Purchases.ViewModels"
             xmlns:local="clr-namespace:MedicalShopManager.App.Modules.Purchases.Views"
             mc:Ignorable="d"
             local:PurchasesFocus.KeyboardForm="True"
             d:DataContext="{d:DesignInstance Type=vm:PurchaseEntryViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PurchasesStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDraftCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="F4" Command="{Binding StartEditCommand}"/>
        <KeyBinding Key="F6" Command="{Binding OpenQuickAddCommand}"/>
        <KeyBinding Key="F7" Command="{Binding OpenPaymentDialogCommand}"/>
        <KeyBinding Key="Delete" Modifiers="Control" Command="{Binding AskDeleteCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AddLineCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelLineEditCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="140"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ Title bar ═══════════ -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀ Purchases" Style="{StaticResource SecondaryButton}" Command="{Binding BackToListCommand}" Margin="0,0,8,0" IsTabStop="False"/>
                    <Button Content="New (Ctrl+N)" Style="{StaticResource SecondaryButton}" Command="{Binding NewCommand}" Margin="0,0,8,0" IsTabStop="False"/>
                    <Button Content="Print (Ctrl+P)" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}" Margin="0,0,8,0" IsTabStop="False"
                            Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <Button Content="Return items" Style="{StaticResource SecondaryButton}" Command="{Binding ReturnItemsCommand}" Margin="0,0,8,0" IsTabStop="False"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Record payment (F7)" Style="{StaticResource SecondaryButton}" Command="{Binding OpenPaymentDialogCommand}" Margin="0,0,8,0" IsTabStop="False"
                            Visibility="{Binding CanRecordPayment, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Edit (F4)" Style="{StaticResource SecondaryButton}" Command="{Binding StartEditCommand}" Margin="0,0,8,0" IsTabStop="False"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Delete (Ctrl+Del)" Style="{StaticResource DangerButton}" Command="{Binding AskDeleteCommand}" Margin="0,0,8,0" IsTabStop="False"
                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Cancel edit" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}" Margin="0,0,8,0" IsTabStop="False"
                            Visibility="{Binding IsConfirmed, Converter={StaticResource BoolToVisibility}}"
                            IsEnabled="{Binding IsEditing}"/>
                    <Button Content="Save draft (Ctrl+S)" Style="{StaticResource SecondaryButton}" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" IsTabStop="False"
                            Visibility="{Binding CanSaveDraft, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Save (Alt + S)" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsTabStop="False"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding DocumentNumber, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding StatusLabel, Mode=OneWay}"/>
                        <Run Text="  ·  Rates per pack, GST added on top unless 'Rates include GST' is ticked"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- ═══════════ Header ═══════════ -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,10" IsEnabled="{Binding IsEditing}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Style="{StaticResource PurchaseField}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+ New (F6)" Style="{StaticResource SecondaryButton}" Padding="8,0" Height="22" FontSize="11"
                                    Command="{Binding OpenQuickAddCommand}" IsTabStop="False"/>
                            <TextBlock Text="DISTRIBUTOR *" Style="{StaticResource PurchaseLabel}"/>
                        </DockPanel>
                        <TextBox x:Name="DistributorBox" Text="{Binding DistributorSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PurchaseInput}" TabIndex="1" PreviewKeyDown="OnDistributorKeyDown"
                                 ToolTip="Type or press Space to search distributors; F6 adds a new one">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding PickDistributorCommand}"/>
                                <KeyBinding Key="Down" Command="{Binding MoveDistributorSelectionCommand}" CommandParameter="Down"/>
                                <KeyBinding Key="Up" Command="{Binding MoveDistributorSelectionCommand}" CommandParameter="Up"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding DistributorInfo}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,3,0,0" TextTrimming="CharacterEllipsis"/>
                        <Popup IsOpen="{Binding IsDistributorDropdownOpen}" PlacementTarget="{Binding ElementName=DistributorBox}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=DistributorBox}">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="320">
                                <ListBox ItemsSource="{Binding DistributorResults}" SelectedItem="{Binding HighlightedDistributor}" BorderThickness="0"
                                         Focusable="False" MouseDoubleClick="OnDistributorDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,3">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Gstin, Mode=OneWay}"/><Run Text="  ·  Balance ₹"/><Run Text="{Binding OutstandingBalance, Mode=OneWay, StringFormat=N2}"/><Run Text="  ·  "/><Run Text="{Binding CreditDays, Mode=OneWay}"/><Run Text=" days credit"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Style="{StaticResource PurchaseField}">
                        <TextBlock Text="INVOICE NO *" Style="{StaticResource PurchaseLabel}"/>
                        <TextBox x:Name="InvoiceBox" Text="{Binding InvoiceNumber}" Style="{StaticResource PurchaseInput}" TabIndex="2" MaxLength="30"
                                 ToolTip="Enter Bill No here (as printed on the distributor's bill)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Style="{StaticResource PurchaseField}">
                        <TextBlock Text="INVOICE DATE *" Style="{StaticResource PurchaseLabel}"/>
                        <DatePicker SelectedDate="{Binding InvoiceDate}" SelectedDateFormat="Short" TabIndex="3" Height="30"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Style="{StaticResource PurchaseField}">
                        <TextBlock Text="PAYMENT DUE DATE" Style="{StaticResource PurchaseLabel}"/>
                        <DatePicker SelectedDate="{Binding DueDate}" SelectedDateFormat="Short" TabIndex="4" Height="30"
                                    ToolTip="Defaults to invoice date + the distributor's credit days"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="4,14,0,0">
                        <CheckBox Content="Bill has GST column" IsChecked="{Binding WithGst}" TabIndex="5" Margin="0,0,0,4"
                                  ToolTip="No = the distributor's bill has no GST, so GST is not added to the total. Please confirm from the invoice before changing this."/>
                        <CheckBox Content="Rates include GST" IsChecked="{Binding RatesIncludeGst}" TabIndex="6" Margin="0,0,0,4"
                                  ToolTip="Tick when the RATE column of the bill already includes GST; it is backed out to the ex-GST rate"/>
                        <CheckBox Content="IGST (other state)" IsChecked="{Binding IsInterState}" TabIndex="7"
                                  ToolTip="Set automatically from the distributor's GSTIN; IGST instead of CGST + SGST"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ Entry row ═══════════ -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource PurchaseKeyHint}"><TextBlock Text="Enter = next field" Style="{StaticResource PurchaseKeyHintText}"/></Border>
                            <Border Style="{StaticResource PurchaseKeyHint}"><TextBlock Text="Ctrl+Enter = Add" Style="{StaticResource PurchaseKeyHintText}"/></Border>
                            <Border Style="{StaticResource PurchaseKeyHint}"><TextBlock Text="Esc = clear row" Style="{StaticResource PurchaseKeyHintText}"/></Border>
                        </StackPanel>
                        <TextBox x:Name="ProductBox" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PurchaseInput}"
                                 FontSize="14" Height="32" TabIndex="10" ToolTip="PRODUCT / BARCODE: type the name (2+ letters) or scan the barcode, Enter to pick">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SubmitProductCommand}"/>
                                <KeyBinding Key="Down" Command="{Binding MoveProductSelectionCommand}" CommandParameter="Down"/>
                                <KeyBinding Key="Up" Command="{Binding MoveProductSelectionCommand}" CommandParameter="Up"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Text="{Binding ProductSearchMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,4"
                               Visibility="{Binding ProductSearchMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                    <Popup IsOpen="{Binding IsProductDropdownOpen}" PlacementTarget="{Binding ElementName=ProductBox}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=ProductBox}">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="340">
                            <ListBox ItemsSource="{Binding ProductResults}" SelectedItem="{Binding SelectedProduct}" BorderThickness="0"
                                     Focusable="False" MouseDoubleClick="OnProductDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Manufacturer, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Composition, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding UnitsPerPack, StringFormat='1 x {0}'}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DefaultMrp, StringFormat=MRP ₹{0:N2}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding GstRatePercent, StringFormat={}{0:0.##}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>

                    <Grid DataContext="{Binding Editor}" IsEnabled="{Binding HasProduct}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Text="PRODUCT" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="1" Text="HSN" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="2" Text="BATCH" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="EXPIRY MM / YY" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="5" Text="PACK 1x" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="6" Text="QTY (packs)" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="7" Text="FREE" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="8" Text="MRP ₹" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="9" Text="RATE ₹" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="10" Grid.ColumnSpan="2" Text="SCHEME X+Y" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="12" Text="SCH %" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="13" Text="DISC %" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="14" Text="GST %" Style="{StaticResource PurchaseLabel}"/>
                        <TextBlock Grid.Column="15" Text="SALE RATE ₹" Style="{StaticResource PurchaseLabel}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding MedicineName}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HsnCode}" Style="{StaticResource PurchaseInput}" Margin="0,0,3,0" TabIndex="11" MaxLength="8"/>
                        <TextBox x:Name="BatchBox" Grid.Row="1" Grid.Column="2" Text="{Binding BatchNumber}" Style="{StaticResource PurchaseInput}" Margin="0,0,3,0"
                                 TabIndex="12" MaxLength="30" CharacterCasing="Upper"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ExpiryMonth, TargetNullValue=''}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="13" MaxLength="2"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding ExpiryYear, TargetNullValue=''}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="14" MaxLength="4"/>
                        <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding UnitsPerPack}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="15"/>
                        <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding QuantityPacks}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="16"/>
                        <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding FreePacks}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="17"/>
                        <TextBox Grid.Row="1" Grid.Column="8" Text="{Binding Mrp}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="18"/>
                        <TextBox Grid.Row="1" Grid.Column="9" Text="{Binding Rate}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="19"
                                 ToolTip="Purchase rate per pack (PTR / PURC RATE), GST-exclusive unless 'Rates include GST' is ticked"/>
                        <TextBox Grid.Row="1" Grid.Column="10" Text="{Binding SchemeQuantity}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,1,0" TabIndex="20"/>
                        <TextBox Grid.Row="1" Grid.Column="11" Text="{Binding SchemeFreeQuantity}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="21"
                                 ToolTip="Scheme X + Y: Y free packs for every X bought (fills FREE)"/>
                        <TextBox Grid.Row="1" Grid.Column="12" Text="{Binding SchemePercent}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="22"/>
                        <TextBox Grid.Row="1" Grid.Column="13" Text="{Binding DiscountPercent}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="23"/>
                        <TextBox Grid.Row="1" Grid.Column="14" Text="{Binding GstPercent}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,3,0" TabIndex="24"/>
                        <TextBox Grid.Row="1" Grid.Column="15" Text="{Binding SaleRate}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,6,0" TabIndex="25"
                                 ToolTip="Selling rate per pack (GST-inclusive, at most MRP). Defaults from MRP and the sale-rate setting. Enter adds the row.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding DataContext.AddLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel Grid.Row="1" Grid.Column="16" Orientation="Horizontal">
                            <Button Content="{Binding AddButtonText}" Style="{StaticResource PrimaryButton}" Padding="12,0" Height="30" TabIndex="26"
                                    Command="{Binding DataContext.AddLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="✕" Style="{StaticResource SecondaryButton}" Padding="8,0" Height="30" Margin="4,0,0,0" IsTabStop="False" ToolTip="Clear the row (Esc)"
                                    Command="{Binding DataContext.CancelLineEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="17" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="NET RATE ₹"/><Run Text="{Binding NetRate, Mode=OneWay, StringFormat=N2}" FontWeight="SemiBold"/>
                            <Run Text="   MARGIN "/><Run Text="{Binding MarginPercent, Mode=OneWay, StringFormat=0.##}" FontWeight="SemiBold"/><Run Text="%"/>
                            <Run Text="   AMT ₹"/><Run Text="{Binding Amount, Mode=OneWay, StringFormat=N2}" FontWeight="SemiBold"/>
                            <Run Text="   "/><Run Text="{Binding LastPurchaseHint, Mode=OneWay}" Foreground="{StaticResource TextTertiaryBrush}"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════ Lines ═══════════ -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,10">
                <Grid>
                    <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="OnLineDoubleClick">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding EditLineCommand}" CommandParameter="{Binding SelectedLine}"/>
                            <KeyBinding Key="Delete" Command="{Binding RemoveLineCommand}" CommandParameter="{Binding SelectedLine}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding LineNo}" Width="32"/>
                            <DataGridTextColumn Header="PRODUCT" Binding="{Binding MedicineName}" Width="2*"/>
                            <DataGridTextColumn Header="HSN" Binding="{Binding HsnCode}" Width="70"/>
                            <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNumber}" Width="90"/>
                            <DataGridTextColumn Header="EXP" Binding="{Binding ExpiryLabel}" Width="55"/>
                            <DataGridTextColumn Header="PACK" Binding="{Binding UnitsPerPack, StringFormat='1x{0}'}" Width="50"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding QuantityDisplay}" Width="55"/>
                            <DataGridTextColumn Header="FREE" Binding="{Binding FreeQuantityDisplay}" Width="55"/>
                            <DataGridTextColumn Header="MRP" Binding="{Binding MrpPaisa, Converter={StaticResource PaisaToRupees}}" Width="80"/>
                            <DataGridTextColumn Header="RATE" Binding="{Binding EnteredRatePaisa, Converter={StaticResource PaisaToRupees}}" Width="80"/>
                            <DataGridTextColumn Header="SCH %" Binding="{Binding SchemePercent, StringFormat=0.##}" Width="50"/>
                            <DataGridTextColumn Header="DISC %" Binding="{Binding DiscountPercent, StringFormat=0.##}" Width="50"/>
                            <DataGridTextColumn Header="GST %" Binding="{Binding GstRatePercent, StringFormat=0.##}" Width="50"/>
                            <DataGridTextColumn Header="NET RATE" Binding="{Binding NetRatePaisa, Converter={StaticResource PaisaToRupees}}" Width="80"/>
                            <DataGridTextColumn Header="SALE RATE" Binding="{Binding SaleRatePaisa, Converter={StaticResource PaisaToRupees}}" Width="80"/>
                            <DataGridTextColumn Header="MARGIN %" Binding="{Binding MarginPercent, StringFormat=0.##}" Width="65"/>
                            <DataGridTextColumn Header="TAXABLE" Binding="{Binding TaxablePaisa, Converter={StaticResource PaisaToRupees}}" Width="90"/>
                            <DataGridTextColumn Header="AMT" Binding="{Binding LineTotalPaisa, Converter={StaticResource PaisaToRupees}}" Width="95"/>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="6,0" Height="24" FontSize="11" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.EditLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="✕" Style="{StaticResource SecondaryButton}" Padding="6,0" Height="24" FontSize="11" ToolTip="Remove row (Del)"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="No products on this bill yet" Style="{StaticResource PurchaseEmptyTitle}"/>
                        <TextBlock Text="Pick the distributor, then type a product name or scan its barcode above.&#x0a;Have the distributor's CSV / Excel file? Use Purchases ▸ Import Purchase."
                                   Style="{StaticResource PurchaseEmptyHint}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ Footer: charges, payment, totals ═══════════ -->
            <Grid Grid.Row="4" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <WrapPanel IsEnabled="{Binding IsEditing}">
                            <StackPanel Style="{StaticResource PurchaseField}" Width="110">
                                <TextBlock Text="BILL DISCOUNT %" Style="{StaticResource PurchaseLabel}"/>
                                <TextBox Text="{Binding BillDiscountPercent}" Style="{StaticResource PurchaseNumberInput}" TabIndex="40"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource PurchaseField}" Width="150">
                                <TextBlock Text="CHARGE TYPE" Style="{StaticResource PurchaseLabel}"/>
                                <TextBox Text="{Binding OtherChargesLabel}" Style="{StaticResource PurchaseInput}" TabIndex="41" ToolTip="e.g. Delivery charge"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource PurchaseField}" Width="100">
                                <TextBlock Text="CHARGE ₹" Style="{StaticResource PurchaseLabel}"/>
                                <TextBox Text="{Binding OtherCharges}" Style="{StaticResource PurchaseNumberInput}" TabIndex="42"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource PurchaseField}" Width="240">
                                <TextBlock Text="NOTES" Style="{StaticResource PurchaseLabel}"/>
                                <TextBox Text="{Binding Notes}" Style="{StaticResource PurchaseInput}" TabIndex="43" MaxLength="500"/>
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Visibility="{Binding ShowInitialPayment, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource PurchaseField}" Width="110">
                                <TextBlock Text="AMOUNT PAID ₹" Style="{StaticResource PurchaseLabel}"/>
                                <TextBox Text="{Binding PaymentAmount}" Style="{StaticResource PurchaseNumberInput}" TabIndex="44" ToolTip="Leave 0 for a credit purchase"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource PurchaseField}" Width="160">
                                <TextBlock Text="PAYMENT MODE" Style="{StaticResource PurchaseLabel}"/>
                                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" DisplayMemberPath="Label" Height="30" TabIndex="45"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource PurchaseField}" Width="150">
                                <TextBlock Text="REFERENCE / CHEQUE NO" Style="{StaticResource PurchaseLabel}"/>
                                <TextBox Text="{Binding PaymentReference}" Style="{StaticResource PurchaseInput}" TabIndex="46" MaxLength="60"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource PurchaseField}">
                                <TextBlock Text=" " Style="{StaticResource PurchaseLabel}"/>
                                <Button Content="Pay full" Style="{StaticResource SecondaryButton}" Command="{Binding PayFullCommand}" Height="30" Padding="10,0" IsTabStop="False"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Visibility="{Binding HasPayments, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="PAYMENTS" Style="{StaticResource PurchaseLabel}" Margin="0,4,0,2"/>
                            <ItemsControl ItemsSource="{Binding Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding Date, Mode=OneWay, StringFormat=dd-MM-yyyy}"/><Run Text="  ·  ₹"/><Run Text="{Binding Amount, Mode=OneWay, StringFormat=N2}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding Method, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Reference, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasSkippedImportRows, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <TextBlock Text="ROWS NOT IMPORTED" Style="{StaticResource PurchaseLabel}" Foreground="{StaticResource WarningBrush}"/>
                            <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SkippedImportRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11" TextWrapping="Wrap">
                                                <Run Text="Row "/><Run Text="{Binding RowNumber, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding ProductName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" – "/><Run Text="{Binding Errors[0], Mode=OneWay}" Foreground="{StaticResource DangerBrush}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Gross (rate × qty)" Style="{StaticResource PurchaseTotalLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubtotalPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource PurchaseTotalValue}"/>
                        <TextBlock Grid.Row="1" Text="(−) Discount + scheme" Style="{StaticResource PurchaseTotalLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource PurchaseTotalValue}"/>
                        <TextBlock Grid.Row="2" Text="Taxable" Style="{StaticResource PurchaseTotalLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaxablePaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource PurchaseTotalValue}"/>
                        <TextBlock Grid.Row="3" Text="(+) CGST" Style="{StaticResource PurchaseTotalLabel}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CgstPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource PurchaseTotalValue}"/>
                        <TextBlock Grid.Row="4" Text="(+) SGST" Style="{StaticResource PurchaseTotalLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SgstPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource PurchaseTotalValue}"/>
                        <TextBlock Grid.Row="5" Text="(+) IGST" Style="{StaticResource PurchaseTotalLabel}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding IgstPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource PurchaseTotalValue}"/>
                        <TextBlock Grid.Row="6" Text="Round off" Style="{StaticResource PurchaseTotalLabel}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RoundOffLabel}" Style="{StaticResource PurchaseTotalValue}"/>
                        <Separator Grid.Row="7" Grid.ColumnSpan="2" Margin="0,4"/>
                        <TextBlock Grid.Row="8" Text="Total (you'll pay)" Style="{StaticResource PurchaseTotalLabel}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding GrandTotalPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource PurchaseTotalValue}"
                                   FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Grid.Row="9" Text="Paid" Style="{StaticResource PurchaseTotalLabel}"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding AmountPaidPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource PurchaseTotalValue}"/>
                        <TextBlock Grid.Row="10" Text="Balance due" Style="{StaticResource PurchaseTotalLabel}"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding BalancePaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource PurchaseTotalValue}"
                                   Foreground="{StaticResource DangerBrush}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════ Messages ═══════════ -->
            <StackPanel Grid.Row="5">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Errors}" Style="{StaticResource PurchaseErrorList}"/>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Quick-add distributor ═══════════ -->
        <Grid Style="{StaticResource PurchaseOverlay}" Visibility="{Binding IsQuickAddOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource PurchaseDialogCard}" Width="620" local:PurchasesFocus.FocusFirstOnShow="True">
                <Border.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding CloseQuickAddCommand}"/>
                    <KeyBinding Key="S" Modifiers="Alt" Command="{Binding SaveQuickAddCommand}"/>
                </Border.InputBindings>
                <StackPanel>
                    <ContentControl Content="{Binding QuickAdd}" ContentTemplateSelector="{StaticResource ViewLocator}" IsTabStop="False"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel (Esc)" Style="{StaticResource SecondaryButton}" Command="{Binding CloseQuickAddCommand}" Margin="0,0,8,0"/>
                        <Button Content="Save distributor (Alt+S)" Style="{StaticResource PrimaryButton}" Command="{Binding SaveQuickAddCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Duplicate bill warning ═══════════ -->
        <Grid Style="{StaticResource PurchaseOverlay}" Visibility="{Binding IsDuplicateDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource PurchaseDialogCard}" Width="480" local:PurchasesFocus.FocusFirstOnShow="True">
                <StackPanel>
                    <TextBlock Text="This Bill is Duplicate" Style="{StaticResource SectionHeader}" Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="{Binding DuplicateMessage}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Go back" Style="{StaticResource SecondaryButton}" Command="{Binding CancelDuplicateCommand}" Margin="0,0,8,0" IsCancel="True"/>
                        <Button Content="Save anyway" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmDuplicateCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Delete ═══════════ -->
        <Grid Style="{StaticResource PurchaseOverlay}" Visibility="{Binding IsDeleteDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource PurchaseDialogCard}" Width="480" local:PurchasesFocus.FocusFirstOnShow="True">
                <Border.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding CancelDeleteCommand}"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="Are you sure you want to delete this purchase?" Style="{StaticResource SectionHeader}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="A draft is removed. A saved purchase is cancelled and its stock taken back out; this is refused when that stock was already sold or returned, or payments were made."/>
                    <TextBlock Text="REASON" Style="{StaticResource PurchaseLabel}"/>
                    <TextBox Text="{Binding DeleteReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PurchaseInput}" MaxLength="200"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Keep it (Esc)" Style="{StaticResource SecondaryButton}" Command="{Binding CancelDeleteCommand}" Margin="0,0,8,0"/>
                        <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Record payment ═══════════ -->
        <Grid Style="{StaticResource PurchaseOverlay}" Visibility="{Binding IsPaymentDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource PurchaseDialogCard}" Width="440" local:PurchasesFocus.FocusFirstOnShow="True">
                <Border.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding ClosePaymentDialogCommand}"/>
                    <KeyBinding Key="S" Modifiers="Alt" Command="{Binding RecordPaymentCommand}"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="Record payment to distributor" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Margin="0,4,0,10" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Balance due: "/><Run Text="{Binding BalancePaisa, Mode=OneWay, Converter={StaticResource PaisaToRupees}}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="AMOUNT ₹" Style="{StaticResource PurchaseLabel}"/>
                    <TextBox Text="{Binding PaymentAmount}" Style="{StaticResource PurchaseNumberInput}" Margin="0,0,0,8"/>
                    <TextBlock Text="PAYMENT MODE" Style="{StaticResource PurchaseLabel}"/>
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" DisplayMemberPath="Label" Height="30" Margin="0,0,0,8"/>
                    <TextBlock Text="DATE" Style="{StaticResource PurchaseLabel}"/>
                    <DatePicker SelectedDate="{Binding PaymentDate}" Height="30" Margin="0,0,0,8"/>
                    <TextBlock Text="REFERENCE / UTR / CHEQUE NO" Style="{StaticResource PurchaseLabel}"/>
                    <TextBox Text="{Binding PaymentReference}" Style="{StaticResource PurchaseInput}" MaxLength="60"/>
                    <ItemsControl ItemsSource="{Binding Errors}" Style="{StaticResource PurchaseErrorList}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel (Esc)" Style="{StaticResource SecondaryButton}" Command="{Binding ClosePaymentDialogCommand}" Margin="0,0,8,0"/>
                        <Button Content="Save payment (Alt+S)" Style="{StaticResource PrimaryButton}" Command="{Binding RecordPaymentCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="MedicalShopManager.App.Modules.Stock.Views.StockAdjustmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.Stock.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StockAdjustmentViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Alt" Command="{Binding StartEntryCommand}"/>
        <KeyBinding Key="L" Modifiers="Alt" Command="{Binding AddLineCommand}"/>
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelEntryCommand}"/>
        <KeyBinding Key="F5" Command="{Binding LoadHistoryCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="EmptyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Stock Adjustment" Style="{StaticResource PageTitle}" Margin="0,0,12,0"/>
                <TextBlock Text="Damaged, expired, lost, found, count correction or sample stock. Every voucher is numbered and audit-logged."
                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Adjustment (Alt+N)" Command="{Binding StartEntryCommand}" Style="{StaticResource PrimaryButton}" TabIndex="1"/>
        </Grid>

        <Border DockPanel.Dock="Top" Background="{StaticResource SuccessBgBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="{StaticResource DangerBgBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </Border>

        <!-- ═══════════ Entry form ═══════════ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12"
                Visibility="{Binding IsEntryOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Next no.: "/><Run Text="{Binding NextNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="New Stock Adjustment" Style="{StaticResource SectionHeader}" Margin="0"/>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Reason *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding SelectedReason}" DisplayMemberPath="Label" Height="34" TabIndex="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,8">
                        <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding AdjustmentDate}" Height="34" TabIndex="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="Notes (required for count correction)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="250" Style="{StaticResource ModernTextBox}" TabIndex="12"/>
                    </StackPanel>
                </Grid>

                <!-- Line entry -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Search item" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ItemSearch, UpdateSourceTrigger=PropertyChanged, Delay=250}" Style="{StaticResource ModernTextBox}" TabIndex="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Item" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchItem}" DisplayMemberPath="Name" Height="34" TabIndex="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Batch (stock in packs + loose)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding BatchOptions}" SelectedItem="{Binding SelectedBatch}" Height="34" TabIndex="15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding BatchNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="  exp "/><Run Text="{Binding ExpiryLabel, Mode=OneWay}"/>
                                        <Run Text="  stock "/><Run Text="{Binding StockDisplay, Mode=OneWay}"/>
                                        <Run Text="  "/><Run Text="{Binding StatusLabel, Mode=OneWay}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Packs" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Packs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" TabIndex="16"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="Loose" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LooseUnits, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" TabIndex="17">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddLineCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Margin="0,0,8,0" VerticalAlignment="Bottom">
                        <CheckBox Content="Add to stock" IsChecked="{Binding IsAddition}" Margin="0,0,0,8" TabIndex="18"
                                  Visibility="{Binding ShowDirectionChoice, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding DirectionText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    </StackPanel>
                    <Button Grid.Column="6" Content="Add line (Alt+L)" Command="{Binding AddLineCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" TabIndex="19"/>
                </Grid>

                <TextBlock Text="{Binding EntryError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding HasEntryError, Converter={StaticResource BoolToVisibility}}"/>

                <Grid Margin="0,10,0,0" MinHeight="90">
                    <DataGrid ItemsSource="{Binding DraftLines}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding MedicineName}" Width="2*"/>
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="*"/>
                            <DataGridTextColumn Header="Exp" Binding="{Binding ExpiryLabel}" Width="55"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding BalanceDisplay}" Width="70"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding ChangeDisplay}" Width="70" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="After" Binding="{Binding AfterDisplay}" Width="70"/>
                            <DataGridTextColumn Header="Value (₹)" Binding="{Binding Value, StringFormat=N2}" Width="85"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Padding="6,1" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}" Cursor="Hand"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasDraftLines, Converter={StaticResource InverseBoolToVisibility}}"
                               Text="Search an item, pick its batch, enter the quantity and press Enter (or Alt+L)."/>
                </Grid>

                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel (Esc)" Command="{Binding CancelEntryCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" TabIndex="31"/>
                        <Button Content="Save Adjustment (Alt+S)" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" TabIndex="30"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DraftTotalText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════ History ═══════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Width="130" TabIndex="40"/>
                        <TextBlock Text="To" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Width="130" TabIndex="41"/>
                        <Button Content="Show (F5)" Command="{Binding LoadHistoryCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="12,4" TabIndex="42"/>
                    </StackPanel>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Adjustments}" SelectedItem="{Binding SelectedAdjustment}" Style="{StaticResource ModernDataGrid}"
                                  IsReadOnly="True" AutoGenerateColumns="False" TabIndex="43">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Number" Binding="{Binding AdjustmentNumber}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding AdjustmentDate, StringFormat=dd-MM-yyyy}" Width="85"/>
                                <DataGridTextColumn Header="Reason" Binding="{Binding ReasonLabel}" Width="1.3*"/>
                                <DataGridTextColumn Header="Lines" Binding="{Binding LineCount}" Width="50"/>
                                <DataGridTextColumn Header="Value (₹)" Binding="{Binding TotalValue, StringFormat=N2}" Width="85"/>
                                <DataGridTextColumn Header="By" Binding="{Binding CreatedByName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasAdjustments, Converter={StaticResource InverseBoolToVisibility}}"
                                   Text="No adjustments in this period. Press Alt+N to record one."/>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <TextBlock Style="{StaticResource EmptyText}" Text="Select an adjustment to see its lines."
                               Visibility="{Binding HasSelectedDetail, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <DockPanel Visibility="{Binding HasSelectedDetail, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Preview" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0" TabIndex="44"/>
                                <Button Content="Print (Ctrl+P)" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButton}" Padding="10,4" TabIndex="45"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDetail.AdjustmentNumber}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding SelectedDetail.ReasonLabel, Mode=OneWay}"/><Run Text=" · "/>
                                    <Run Text="{Binding SelectedDetail.AdjustmentDate, Mode=OneWay, StringFormat=dd-MM-yyyy}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedDetail.Notes}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding SelectedDetail.Lines}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding MedicineName}" Width="2*"/>
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="*"/>
                                <DataGridTextColumn Header="Change" Binding="{Binding QuantityDisplay}" Width="65" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Before" Binding="{Binding BalanceBefore}" Width="60"/>
                                <DataGridTextColumn Header="After" Binding="{Binding BalanceAfter}" Width="55"/>
                                <DataGridTextColumn Header="Value (₹)" Binding="{Binding Value, StringFormat=N2}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

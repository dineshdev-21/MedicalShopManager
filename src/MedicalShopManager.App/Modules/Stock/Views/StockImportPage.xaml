<UserControl x:Class="MedicalShopManager.App.Modules.Stock.Views.StockImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.Stock.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StockImportViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}"/>
        <KeyBinding Key="F5" Command="{Binding PreviewCommand}"/>
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding ImportCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="EmptyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Upload Stock (CSV)" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Import opening stock or an item master from your old software. Rates are per pack; quantity is packs + loose units."
                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Save template" Command="{Binding SaveTemplateCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" TabIndex="4"/>
                <Button Content="Choose file (Ctrl+O)" Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" TabIndex="1"/>
                <Button Content="Preview (F5)" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" TabIndex="2"/>
                <Button Content="Import valid rows (Alt+S)" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" Style="{StaticResource PrimaryButton}" TabIndex="3"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Background="{StaticResource SuccessBgBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="{StaticResource DangerBgBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="{StaticResource WarningBgBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Messages}" MaxHeight="120">
                <ItemsControl.Template>
                    <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column mapping -->
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Column mapping" Style="{StaticResource SectionHeader}" Margin="0"/>
                        <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Columns}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" TabIndex="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File column" Binding="{Binding Header, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="Sample" Binding="{Binding Sample, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTemplateColumn Header="Maps to" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Fields, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Field, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasFile, Converter={StaticResource InverseBoolToVisibility}}"
                                   Text="Choose a CSV file (Ctrl+O). Columns are matched automatically by their headers; use 'Save template' for the expected layout."/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Preview -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox DockPanel.Dock="Right" Content="Show only rows with errors" IsChecked="{Binding ShowOnlyErrors}" VerticalAlignment="Center" TabIndex="6"/>
                        <StackPanel>
                            <TextBlock Text="Preview" Style="{StaticResource SectionHeader}" Margin="0"/>
                            <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                  EnableRowVirtualization="True" TabIndex="7">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="45"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding ActionLabel}" Width="130" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Company" Binding="{Binding Manufacturer}" Width="*"/>
                                <DataGridTextColumn Header="Pack" Binding="{Binding UnitsPerPack}" Width="45"/>
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="*"/>
                                <DataGridTextColumn Header="Exp" Binding="{Binding ExpiryLabel}" Width="55"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding QuantityLabel}" Width="60"/>
                                <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="70"/>
                                <DataGridTextColumn Header="GST %" Binding="{Binding GstPercent, StringFormat='0.##'}" Width="50"/>
                                <DataGridTextColumn Header="Errors / warnings" Binding="{Binding MessagesLabel}" Width="2.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}"
                                   Text="Press Preview (F5) to validate every row before anything is saved."/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

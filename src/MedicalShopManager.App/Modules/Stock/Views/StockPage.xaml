<UserControl x:Class="MedicalShopManager.App.Modules.Stock.Views.StockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.Stock.ViewModels"
             xmlns:views="clr-namespace:MedicalShopManager.App.Modules.Stock.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StockViewModel}">

    <UserControl.InputBindings>
        <KeyBinding Key="Left" Modifiers="Control" Command="{Binding PreviousCommand}"/>
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding NextCommand}"/>
        <KeyBinding Key="F4" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="N" Modifiers="Alt" Command="{Binding AddNewItemCommand}"/>
        <KeyBinding Key="B" Modifiers="Alt" Command="{Binding AddNewBatchCommand}"/>
        <KeyBinding Key="E" Modifiers="Alt" Command="{Binding EditItemCommand}"/>
        <KeyBinding Key="A" Modifiers="Alt" Command="{Binding AdjustStockCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintStatementCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="6"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="StockLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        </Style>
        <Style x:Key="StockValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource InfoBgBrush}"/>
        </Style>
        <!-- In stock = green, low = amber, out = red -->
        <Style x:Key="StockPillStyle" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                    <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInStock}" Value="False">
                    <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EmptyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel>
            <!-- ═══════════ Toolbar ═══════════ -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Stock" Style="{StaticResource PageTitle}" Margin="0,0,12,0"/>
                    <TextBlock Text="Ctrl+← / Ctrl+→ prev / next · F4 settings · Ctrl+1…7 tabs" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="+ Add New Item (Alt+N)" Command="{Binding AddNewItemCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" TabIndex="20"/>
                    <Button Content="+ Add New Batch (Alt+B)" Command="{Binding AddNewBatchCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" TabIndex="21"/>
                    <Button Content="Adjust (Alt+A)" Command="{Binding AdjustStockCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" TabIndex="22"/>
                    <Button Content="Settings (F4)" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" TabIndex="23"/>
                    <Button Content="Print (Ctrl+P)" Command="{Binding PrintStatementCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" TabIndex="24"/>
                    <Button Content="Refresh (F5)" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" TabIndex="25"/>
                </StackPanel>
            </Grid>

            <!-- Status / error banners -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SuccessBgBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <Border DockPanel.Dock="Top" Background="{StaticResource DangerBgBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="300"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════ Left: Stock on hand ═══════════ -->
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ListCountText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                                <StackPanel>
                                    <TextBlock Text="STOCK ON HAND" Style="{StaticResource StockLabel}"/>
                                    <TextBlock Text="{Binding StockOnHandText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Style="{StaticResource ModernTextBox}"
                                     TabIndex="1" ToolTip="Search name, composition, company, barcode or rack (all words must match)"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" Height="30" TabIndex="2" ToolTip="Stock filter"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label" Height="30" TabIndex="3" ToolTip="Sort"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding SelectedSchedule}" DisplayMemberPath="Label" Height="30" TabIndex="4" ToolTip="Drug schedule"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding SelectedManufacturer}" Height="30"
                                          IsTextSearchEnabled="True" TabIndex="5" ToolTip="Company / manufacturer"/>
                            </Grid>
                            <DockPanel Margin="0,6,0,6">
                                <Button DockPanel.Dock="Right" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextLinkBrush}" Cursor="Hand" TabIndex="7"/>
                                <CheckBox Content="Include inactive items" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center" TabIndex="6"/>
                            </DockPanel>
                        </StackPanel>

                        <Grid>
                            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" TabIndex="8"
                                     BorderThickness="0" HorizontalContentAlignment="Stretch"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="4,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource StockPillStyle}">
                                                        <TextBlock Text="{Binding StockPill}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource DangerBgBrush}"
                                                            Visibility="{Binding IsPrescription, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding ScheduleLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding ManufacturerLabel, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding PackDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                                <DockPanel Grid.Row="2" Margin="0,2,0,0">
                                                    <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold">
                                                        <Run Text="Stock "/>
                                                        <Run Text="{Binding StockDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="MRP ₹"/><Run Text="{Binding Mrp, Mode=OneWay, StringFormat=N2}"/>
                                                        <Run Text="  Exp "/><Run Text="{Binding ExpiryLabel, Mode=OneWay}"/>
                                                        <Run Text="  "/><Run Text="{Binding BatchCountLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}"
                                       Text="No items match. Clear the filters, or add an item with Alt+N."/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ═══════════ Right: item detail ═══════════ -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"
                                   Text="Select an item on the left to see its batches, purchases, sales and stock timeline."/>

                        <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <!-- Header -->
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="◀ PREV" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" ToolTip="Ctrl+Left" TabIndex="30"/>
                                        <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Button Content="NEXT ▶" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" ToolTip="Ctrl+Right" TabIndex="31"/>
                                        <Button Content="Edit (Alt+E)" Command="{Binding EditItemCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" TabIndex="32"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Header.Name}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <Border Style="{StaticResource Pill}" Background="{StaticResource DangerBgBrush}" Margin="8,0,0,0"
                                                    Visibility="{Binding Header.IsPrescription, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Header.ScheduleLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource Pill}" Background="{StaticResource WarningBgBrush}"
                                                    Visibility="{Binding Header.IsActive, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="Inactive" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Header.Manufacturer}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                                                   Visibility="{Binding HasComposition, Converter={StaticResource BoolToVisibility}}">
                                            <Run Text="Composition: "/><Run Text="{Binding Header.Composition, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>

                                <UniformGrid Columns="5" Margin="0,10,0,10">
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="PACK" Style="{StaticResource StockLabel}"/><TextBlock Text="{Binding Header.PackDisplay}" Style="{StaticResource StockValue}"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="EXPIRY" Style="{StaticResource StockLabel}"/><TextBlock Text="{Binding Header.ExpiryLabel}" Style="{StaticResource StockValue}"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="LOCATION" Style="{StaticResource StockLabel}"/><TextBlock Text="{Binding Header.LocationLabel}" Style="{StaticResource StockValue}"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="STOCK (PACKS + LOOSE)" Style="{StaticResource StockLabel}"/><TextBlock Text="{Binding Header.StockDisplay}" Style="{StaticResource StockValue}"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="GST / HSN" Style="{StaticResource StockLabel}"/>
                                        <TextBlock Style="{StaticResource StockValue}"><Run Text="{Binding Header.GstRatePercent, Mode=OneWay, StringFormat='{}{0:0.##}%'}"/><Run Text=" / "/><Run Text="{Binding Header.HsnCode, Mode=OneWay, TargetNullValue='-'}"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel><TextBlock Text="MRP" Style="{StaticResource StockLabel}"/><TextBlock Text="{Binding Header.Mrp, StringFormat='₹{0:N2}'}" Style="{StaticResource StockValue}"/></StackPanel>
                                    <StackPanel><TextBlock Text="PURC RATE" Style="{StaticResource StockLabel}"/><TextBlock Text="{Binding Header.PurchaseRate, StringFormat='₹{0:N2}'}" Style="{StaticResource StockValue}"/></StackPanel>
                                    <StackPanel><TextBlock Text="NET RATE" Style="{StaticResource StockLabel}"/><TextBlock Text="{Binding Header.NetRate, StringFormat='₹{0:N2}'}" Style="{StaticResource StockValue}"/></StackPanel>
                                    <StackPanel><TextBlock Text="SALE RATE" Style="{StaticResource StockLabel}"/><TextBlock Text="{Binding Header.SaleRate, StringFormat='₹{0:N2}'}" Style="{StaticResource StockValue}"/></StackPanel>
                                    <StackPanel><TextBlock Text="MARGIN" Style="{StaticResource StockLabel}"/><TextBlock Text="{Binding MarginText}" Style="{StaticResource StockValue}" Foreground="{StaticResource SuccessBrush}"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Tabs: BATCHES | PURCHASES | SALES | TIMELINE | SUBSTITUTE | BRANCH STK | DISTRIBUTOR -->
                            <TabControl SelectedIndex="{Binding SelectedTabIndex}" TabIndex="40">
                                <TabItem Header="BATCHES">
                                    <DockPanel Margin="0,6,0,0">
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="+ Add New Batch" Command="{Binding AddNewBatchCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                                            <CheckBox Content="Show zero-stock batches" IsChecked="{Binding ShowZeroBatches}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Grid>
                                            <DataGrid ItemsSource="{Binding Batches}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="1.2*"/>
                                                    <DataGridTextColumn Header="Pack" Binding="{Binding PackDisplay}" Width="55"/>
                                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryLabel}" Width="60"/>
                                                    <DataGridTemplateColumn Header="Status" Width="95">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StatusLabel}" ToolTip="{Binding ExpiryHint}" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Near Expiry"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Expired"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Stock Out"><Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Inactive"><Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="70"/>
                                                    <DataGridTextColumn Header="Purc Rate" Binding="{Binding PurchaseRate, StringFormat=N2}" Width="75"/>
                                                    <DataGridTextColumn Header="Net Rate" Binding="{Binding NetRate, StringFormat=N2}" Width="70"/>
                                                    <DataGridTextColumn Header="Sale Rate" Binding="{Binding SaleRate, StringFormat=N2}" Width="70"/>
                                                    <DataGridTextColumn Header="Margin %" Binding="{Binding MarginPercent, StringFormat='0.##'}" Width="65"/>
                                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockDisplay}" Width="70" FontWeight="SemiBold"/>
                                                    <DataGridTemplateColumn Header="" Width="70">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Adjust" Padding="8,1" FontSize="11" Style="{StaticResource SecondaryButton}" MinHeight="22"
                                                                        Command="{Binding DataContext.AdjustStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasBatches, Converter={StaticResource InverseBoolToVisibility}}"
                                                       Text="No batches in stock. Add opening stock with + Add New Batch (Alt+B), or tick 'Show zero-stock batches'."/>
                                        </Grid>
                                    </DockPanel>
                                </TabItem>

                                <TabItem Header="PURCHASES">
                                    <Grid Margin="0,6,0,0">
                                        <DataGrid ItemsSource="{Binding Purchases}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat=dd-MM-yyyy}" Width="85"/>
                                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*"/>
                                                <DataGridTextColumn Header="Distributor" Binding="{Binding SupplierName}" Width="1.5*"/>
                                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="*"/>
                                                <DataGridTextColumn Header="Exp" Binding="{Binding ExpiryLabel}" Width="55"/>
                                                <DataGridTextColumn Header="Qty" Binding="{Binding QuantityDisplay}" Width="55"/>
                                                <DataGridTextColumn Header="Free" Binding="{Binding FreeDisplay}" Width="50"/>
                                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=N2}" Width="65"/>
                                                <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="65"/>
                                                <DataGridTextColumn Header="Amount" Binding="{Binding LineTotal, StringFormat=N2}" Width="80"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="75"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasPurchases, Converter={StaticResource InverseBoolToVisibility}}"
                                                   Text="No purchases of this item yet."/>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="SALES">
                                    <Grid Margin="0,6,0,0">
                                        <DataGrid ItemsSource="{Binding Sales}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd-MM-yyyy HH:mm}" Width="115"/>
                                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*"/>
                                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="1.5*"/>
                                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="*"/>
                                                <DataGridTextColumn Header="Qty" Binding="{Binding QuantityDisplay}" Width="60"/>
                                                <DataGridTextColumn Header="Rate" Binding="{Binding UnitPrice, StringFormat=N2}" Width="65"/>
                                                <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent, StringFormat='0.##'}" Width="55"/>
                                                <DataGridTextColumn Header="Amount" Binding="{Binding LineTotal, StringFormat=N2}" Width="80"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasSales, Converter={StaticResource InverseBoolToVisibility}}"
                                                   Text="No sales of this item yet."/>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="TIMELINE">
                                    <Grid Margin="0,6,0,0">
                                        <DataGrid ItemsSource="{Binding Timeline}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy HH:mm}" Width="115"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding MovementLabel}" Width="105"/>
                                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="*"/>
                                                <DataGridTextColumn Header="In" Binding="{Binding QuantityIn}" Width="55"/>
                                                <DataGridTextColumn Header="Out" Binding="{Binding QuantityOut}" Width="55"/>
                                                <DataGridTextColumn Header="Batch Bal." Binding="{Binding BatchBalanceAfter}" Width="70"/>
                                                <DataGridTextColumn Header="Item Bal." Binding="{Binding RunningBalance}" Width="70" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/>
                                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="1.5*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasTimeline, Converter={StaticResource InverseBoolToVisibility}}"
                                                   Text="No stock movements recorded for this item. Quantities are in units."/>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="SUBSTITUTE">
                                    <Grid Margin="0,6,0,0">
                                        <DataGrid ItemsSource="{Binding Substitutes}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Company" Binding="{Binding Manufacturer}" Width="1.5*"/>
                                                <DataGridTextColumn Header="Pack" Binding="{Binding PackLabel}" Width="60"/>
                                                <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="70"/>
                                                <DataGridTextColumn Header="Stock" Binding="{Binding StockDisplay}" Width="70"/>
                                                <DataGridTextColumn Header="Rack" Binding="{Binding RackLocation}" Width="60"/>
                                                <DataGridTemplateColumn Header="" Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Open" Padding="8,1" FontSize="11" Style="{StaticResource SecondaryButton}" MinHeight="22"
                                                                    Command="{Binding DataContext.OpenSubstituteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasSubstitutes, Converter={StaticResource InverseBoolToVisibility}}"
                                                   Text="No other item has the same composition. Set the composition on items (Alt+E) to see substitutes."/>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="BRANCH STK" IsEnabled="False" ToolTip="Branch stock needs multi-branch sync, which this offline edition does not have.">
                                    <TextBlock Style="{StaticResource EmptyText}" Text="Branch stock is available only with multi-branch (cloud) sync."/>
                                </TabItem>

                                <TabItem Header="DISTRIBUTOR">
                                    <Grid Margin="0,6,0,0">
                                        <DataGrid ItemsSource="{Binding Distributors}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Distributor" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*"/>
                                                <DataGridTextColumn Header="Purchases" Binding="{Binding PurchaseCount}" Width="75"/>
                                                <DataGridTextColumn Header="Units bought" Binding="{Binding TotalUnits}" Width="85"/>
                                                <DataGridTextColumn Header="Last purchase" Binding="{Binding LastPurchaseDate, StringFormat=dd-MM-yyyy}" Width="95"/>
                                                <DataGridTextColumn Header="Last rate" Binding="{Binding LastRate, StringFormat=N2}" Width="75"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Style="{StaticResource EmptyText}" Visibility="{Binding HasDistributors, Converter={StaticResource InverseBoolToVisibility}}"
                                                   Text="No confirmed purchases of this item from any distributor yet."/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ═══════════ Dialog overlay ═══════════ -->
        <Grid Background="#80000000" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <views:StockItemEditorView DataContext="{Binding ItemEditor}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}"/>
            <views:StockNewBatchView DataContext="{Binding BatchEditor}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}"/>
            <views:StockItemSettingsView DataContext="{Binding SettingsEditor}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</UserControl>

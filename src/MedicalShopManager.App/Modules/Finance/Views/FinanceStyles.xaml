<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Finance module styles (merged by the Finance views; built on the shared Theme.xaml brushes). -->

    <Style x:Key="FinLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="FinValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="FinField" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,10,8"/>
    </Style>

    <Style x:Key="FinInput" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FinNumberInput" TargetType="TextBox" BasedOn="{StaticResource FinInput}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="FinModeButton" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="FinPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource InfoBgBrush}"/>
    </Style>

    <Style x:Key="FinDialogCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FinOverlay" TargetType="Grid">
        <Setter Property="Background" Value="#80000000"/>
    </Style>

    <Style x:Key="FinErrorList" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,6,0,6"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,1"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FinTotalLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,2,12,2"/>
    </Style>

    <Style x:Key="FinTotalValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="FinFooterItem" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,24,0"/>
    </Style>

    <Style x:Key="FinEmptyTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="FinEmptyHint" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
    </Style>

    <Style x:Key="FinKeyHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Register rows: cancelled greyed out, bounced in red. Bound to an IsActive / StatusLabel on the row. -->
    <Style x:Key="FinStatusRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusLabel}" Value="Cancelled">
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusLabel}" Value="Cheque bounced">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusLabel}" Value="Bounced">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusLabel}" Value="Cleared">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Expense rows: cancelled greyed out. -->
    <Style x:Key="FinExpenseRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Movement rows: cancelled greyed out. -->
    <Style x:Key="FinMovementRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Account rows: inactive greyed out. -->
    <Style x:Key="FinAccountRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Due rows: overdue (> 90 days) in red, rows being paid highlighted. -->
    <Style x:Key="FinDueRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelectedForPayment}" Value="True">
                <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

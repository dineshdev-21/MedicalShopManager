<UserControl x:Class="MedicalShopManager.App.Modules.Finance.Views.FinancePartyLedgersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.Finance.ViewModels"
             xmlns:local="clr-namespace:MedicalShopManager.App.Modules.Finance.Views"
             mc:Ignorable="d"
             local:FinanceFocus.KeyboardForm="True"
             d:DataContext="{d:DesignInstance Type=vm:FinancePartyLedgersViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FinanceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="R" Modifiers="Alt" Command="{Binding SettleCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportLedgerCommand}"/>
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportBalancesCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="F2" Command="{Binding PreviewCommand}"/>
    </UserControl.InputBindings>

    <DockPanel Margin="0,0,8,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Export outstanding (Ctrl+Shift+E)" Style="{StaticResource SecondaryButton}" Command="{Binding ExportBalancesCommand}" Margin="0,0,6,0" TabIndex="20"/>
                <Button Content="{Binding PayButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding SettleCommand}" TabIndex="21"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Party Ledgers" Style="{StaticResource PageTitle}" Margin="0"/>
                <TextBlock Text="Customer receivables and supplier payables with ageing, and each party's ledger."
                           Style="{StaticResource FinKeyHint}"/>
                <TextBlock Text="Alt+R receive / pay  ·  Ctrl+E export ledger  ·  Ctrl+P print  ·  F2 preview  ·  F5 refresh" Style="{StaticResource FinKeyHint}"/>
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,10">
            <WrapPanel>
                <StackPanel Style="{StaticResource FinField}" Width="210">
                    <TextBlock Text="SHOW" Style="{StaticResource FinLabel}"/>
                    <ComboBox ItemsSource="{Binding PartyTypes}" SelectedItem="{Binding SelectedPartyType}" DisplayMemberPath="Label" Height="30" TabIndex="1"/>
                </StackPanel>
                <StackPanel Style="{StaticResource FinField}" Width="135">
                    <TextBlock Text="OUTSTANDING AS ON" Style="{StaticResource FinLabel}"/>
                    <DatePicker SelectedDate="{Binding AsOfDate}" Height="30" TabIndex="2"/>
                </StackPanel>
                <StackPanel Style="{StaticResource FinField}" Width="250">
                    <TextBlock Text="FIND PARTY (NAME / PHONE / GSTIN)" Style="{StaticResource FinLabel}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FinInput}" TabIndex="3"/>
                </StackPanel>
                <CheckBox Content="Show settled parties" IsChecked="{Binding IncludeSettled}" VerticalAlignment="Center" Margin="0,8,0,0" TabIndex="4"/>
            </WrapPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
            <Border Style="{StaticResource CardStyle}" Padding="14,8" Margin="0,4,0,0">
                <WrapPanel>
                    <StackPanel Style="{StaticResource FinFooterItem}">
                        <TextBlock Text="PARTIES" Style="{StaticResource FinLabel}"/>
                        <TextBlock Text="{Binding PartyCount}" Style="{StaticResource FinValue}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinFooterItem}">
                        <TextBlock Text="0-30 DAYS" Style="{StaticResource FinLabel}"/>
                        <TextBlock Text="{Binding Days0To30Paisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinFooterItem}">
                        <TextBlock Text="31-60 DAYS" Style="{StaticResource FinLabel}"/>
                        <TextBlock Text="{Binding Days31To60Paisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinFooterItem}">
                        <TextBlock Text="61-90 DAYS" Style="{StaticResource FinLabel}"/>
                        <TextBlock Text="{Binding Days61To90Paisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinFooterItem}">
                        <TextBlock Text="OVER 90 DAYS" Style="{StaticResource FinLabel}"/>
                        <TextBlock Text="{Binding Over90Paisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinFooterItem}">
                        <TextBlock Text="CREDITS / ADVANCE" Style="{StaticResource FinLabel}"/>
                        <TextBlock Text="{Binding CreditsPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinFooterItem}">
                        <TextBlock Text="{Binding NetDueTitle}" Style="{StaticResource FinLabel}"/>
                        <TextBlock Text="{Binding NetDuePaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </WrapPanel>
            </Border>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Outstanding by party with ageing -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Parties}" SelectedItem="{Binding SelectedParty}" Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" TabIndex="5">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SettleCommand}"/>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SettleCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PARTY" Binding="{Binding Name}" Width="1.6*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="95"/>
                            <DataGridTextColumn Header="BILLS" Binding="{Binding OpenDocumentCount}" Width="50"/>
                            <DataGridTextColumn Header="0-30" Binding="{Binding Ageing.Days0To30Paisa, Converter={StaticResource PaisaToRupees}}" Width="85"/>
                            <DataGridTextColumn Header="31-60" Binding="{Binding Ageing.Days31To60Paisa, Converter={StaticResource PaisaToRupees}}" Width="85"/>
                            <DataGridTextColumn Header="61-90" Binding="{Binding Ageing.Days61To90Paisa, Converter={StaticResource PaisaToRupees}}" Width="85"/>
                            <DataGridTextColumn Header="90+" Binding="{Binding Ageing.Over90Paisa, Converter={StaticResource PaisaToRupees}}" Width="85"/>
                            <DataGridTextColumn Header="CREDITS" Binding="{Binding CreditsPaisa, Converter={StaticResource PaisaToRupees}}" Width="85"/>
                            <DataGridTextColumn Header="NET DUE" Binding="{Binding NetDuePaisa, Converter={StaticResource PaisaToRupees}}" Width="95" FontWeight="SemiBold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsPartiesEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Nothing outstanding" Style="{StaticResource FinEmptyTitle}"/>
                        <TextBlock Text="{Binding EmptyPartiesHint}" Style="{StaticResource FinEmptyHint}" MaxWidth="360"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"/>

            <!-- Ledger of the selected party -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                        <TextBlock Text="{Binding LedgerHeading}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FinField}" Width="130">
                                <TextBlock Text="LEDGER FROM" Style="{StaticResource FinLabel}"/>
                                <DatePicker SelectedDate="{Binding FromDate}" Height="30" TabIndex="6"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FinField}" Width="130">
                                <TextBlock Text="TO" Style="{StaticResource FinLabel}"/>
                                <DatePicker SelectedDate="{Binding ToDate}" Height="30" TabIndex="7"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <Button Content="This month" Style="{StaticResource SecondaryButton}" Command="{Binding ThisMonthCommand}" Margin="0,0,6,0" TabIndex="8"/>
                                <Button Content="This FY" Style="{StaticResource SecondaryButton}" Command="{Binding ThisYearCommand}" Margin="0,0,6,0" TabIndex="9"/>
                                <Button Content="Last FY" Style="{StaticResource SecondaryButton}" Command="{Binding LastYearCommand}" TabIndex="10"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Export (Ctrl+E)" Style="{StaticResource SecondaryButton}" Command="{Binding ExportLedgerCommand}" Margin="0,0,6,0" TabIndex="12"/>
                                <Button Content="Preview (F2)" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewCommand}" Margin="0,0,6,0" TabIndex="13"/>
                                <Button Content="Print (Ctrl+P)" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}" TabIndex="14"/>
                            </StackPanel>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource FinFooterItem}">
                                    <TextBlock Text="OPENING" Style="{StaticResource FinLabel}"/>
                                    <TextBlock Text="{Binding OpeningLabel}" Style="{StaticResource FinValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FinFooterItem}">
                                    <TextBlock Text="DEBIT" Style="{StaticResource FinLabel}"/>
                                    <TextBlock Text="{Binding TotalDebitPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FinFooterItem}">
                                    <TextBlock Text="CREDIT" Style="{StaticResource FinLabel}"/>
                                    <TextBlock Text="{Binding TotalCreditPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FinFooterItem}">
                                    <TextBlock Text="CLOSING" Style="{StaticResource FinLabel}"/>
                                    <TextBlock Text="{Binding ClosingLabel}" Style="{StaticResource FinValue}" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <DataGrid ItemsSource="{Binding Lines}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" TabIndex="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd-MM-yy}" Width="75"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding SourceLabel}" Width="105"/>
                                <DataGridTextColumn Header="REFERENCE" Binding="{Binding Reference}" Width="115" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="DETAILS" Binding="{Binding Description}" Width="1.5*"/>
                                <DataGridTextColumn Header="DEBIT" Binding="{Binding DebitPaisa, Converter={StaticResource PaisaToRupees}}" Width="90"/>
                                <DataGridTextColumn Header="CREDIT" Binding="{Binding CreditPaisa, Converter={StaticResource PaisaToRupees}}" Width="90"/>
                                <DataGridTextColumn Header="BALANCE" Binding="{Binding BalanceLabel}" Width="115" FontWeight="SemiBold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLedgerEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="No entries in this period" Style="{StaticResource FinEmptyTitle}"/>
                            <TextBlock Text="Widen the ledger dates. Dr = the party owes the shop, Cr = the shop owes the party."
                                       Style="{StaticResource FinEmptyHint}" MaxWidth="340"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="MedicalShopManager.App.Modules.Finance.Views.ExpensesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.Modules.Finance.ViewModels"
             xmlns:local="clr-namespace:MedicalShopManager.App.Modules.Finance.Views"
             mc:Ignorable="d"
             local:FinanceFocus.KeyboardForm="True"
             d:DataContext="{d:DesignInstance Type=vm:ExpensesViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FinanceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="N" Modifiers="Alt" Command="{Binding NewExpenseCommand}"/>
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding SaveExpenseCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}"/>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding ManageCategoriesCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding BeginCancelCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseDialogsCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <DockPanel Margin="0,0,8,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Today" Style="{StaticResource SecondaryButton}" Command="{Binding TodayCommand}" Margin="0,0,6,0"/>
                    <Button Content="This month" Style="{StaticResource SecondaryButton}" Command="{Binding ThisMonthCommand}" Margin="0,0,6,0"/>
                    <Button Content="This FY" Style="{StaticResource SecondaryButton}" Command="{Binding ThisYearCommand}" Margin="0,0,6,0"/>
                    <Button Content="Categories (Ctrl+K)" Style="{StaticResource SecondaryButton}" Command="{Binding ManageCategoriesCommand}" Margin="0,0,6,0"/>
                    <Button Content="Export (Ctrl+E)" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}" Margin="0,0,6,0"/>
                    <Button Content="Add expense (Alt+N)" Style="{StaticResource PrimaryButton}" Command="{Binding NewExpenseCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Expenses" Style="{StaticResource PageTitle}" Margin="0"/>
                    <TextBlock Text="Shop running costs with GST input and the account they were paid from." Style="{StaticResource FinKeyHint}"/>
                    <TextBlock Text="Alt+N add  ·  Enter edit  ·  Del cancel  ·  Ctrl+E export  ·  Ctrl+K categories  ·  F5 refresh" Style="{StaticResource FinKeyHint}"/>
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,10">
                <WrapPanel>
                    <StackPanel Style="{StaticResource FinField}" Width="230">
                        <TextBlock Text="SEARCH NUMBER / PAYEE / BILL / DETAILS" Style="{StaticResource FinLabel}"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FinInput}" ToolTip="Press Enter to search.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding RefreshCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinField}" Width="135">
                        <TextBlock Text="FROM" Style="{StaticResource FinLabel}"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Height="30"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinField}" Width="135">
                        <TextBlock Text="TO" Style="{StaticResource FinLabel}"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Height="30"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinField}" Width="170">
                        <TextBlock Text="CATEGORY" Style="{StaticResource FinLabel}"/>
                        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}" DisplayMemberPath="Label" Height="30"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinField}" Width="170">
                        <TextBlock Text="PAID FROM" Style="{StaticResource FinLabel}"/>
                        <ComboBox ItemsSource="{Binding AccountFilters}" SelectedItem="{Binding SelectedAccountFilter}" DisplayMemberPath="Label" Height="30"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FinField}" Width="170">
                        <TextBlock Text="GST" Style="{StaticResource FinLabel}"/>
                        <ComboBox ItemsSource="{Binding GstFilters}" SelectedItem="{Binding SelectedGstFilter}" DisplayMemberPath="Label" Height="30"/>
                    </StackPanel>
                    <CheckBox Content="Show cancelled" IsChecked="{Binding IncludeCancelled}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                </WrapPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                <Border Style="{StaticResource CardStyle}" Padding="14,8" Margin="0,4,0,0">
                    <DockPanel>
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding CategoryTotals}" MaxWidth="520">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FinPill}" Margin="0,0,6,4">
                                        <TextBlock FontSize="11">
                                            <Run Text="{Binding CategoryName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding AmountPaisa, Mode=OneWay, Converter={StaticResource PaisaToRupees}}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FinFooterItem}">
                                <TextBlock Text="EXPENSES" Style="{StaticResource FinLabel}"/>
                                <TextBlock Text="{Binding Totals.Count}" Style="{StaticResource FinValue}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FinFooterItem}">
                                <TextBlock Text="TAXABLE" Style="{StaticResource FinLabel}"/>
                                <TextBlock Text="{Binding Totals.TaxablePaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FinFooterItem}">
                                <TextBlock Text="GST INPUT" Style="{StaticResource FinLabel}"/>
                                <TextBlock Text="{Binding Totals.TaxPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FinFooterItem}">
                                <TextBlock Text="TOTAL PAID" Style="{StaticResource FinLabel}"/>
                                <TextBlock Text="{Binding Totals.AmountPaisa, Converter={StaticResource PaisaToRupees}}" Style="{StaticResource FinValue}"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource FinExpenseRow}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding EditExpenseCommand}"/>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditExpenseCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NUMBER" Binding="{Binding NumberDisplay}" Width="115" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="DATE" Binding="{Binding ExpenseDate, StringFormat=dd-MM-yy}" Width="75"/>
                            <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="120"/>
                            <DataGridTextColumn Header="PAYEE" Binding="{Binding PayeeName}" Width="1.3*"/>
                            <DataGridTextColumn Header="DETAILS" Binding="{Binding Description}" Width="1.6*"/>
                            <DataGridTextColumn Header="BILL NO" Binding="{Binding InvoiceNumber}" Width="85"/>
                            <DataGridTextColumn Header="TAXABLE" Binding="{Binding TaxablePaisa, Converter={StaticResource PaisaToRupees}}" Width="90"/>
                            <DataGridTextColumn Header="GST" Binding="{Binding TaxPaisa, Converter={StaticResource PaisaToRupees}}" Width="75"/>
                            <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountPaisa, Converter={StaticResource PaisaToRupees}}" Width="95" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="PAID FROM" Binding="{Binding AccountName}" Width="120"/>
                            <DataGridTextColumn Header="MODE" Binding="{Binding ModeLabel}" Width="80"/>
                            <DataGridTemplateColumn Header="ACTIONS" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0" Focusable="False"
                                                    Command="{Binding DataContext.EditExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="Cancel" Style="{StaticResource DangerButton}" Padding="8,2" Focusable="False"
                                                    Command="{Binding DataContext.BeginCancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="No expenses" Style="{StaticResource FinEmptyTitle}"/>
                        <TextBlock Text="Nothing recorded in this period. Press Alt+N to add rent, salary, electricity or any other expense."
                                   Style="{StaticResource FinEmptyHint}" MaxWidth="420"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Add / edit expense -->
        <Grid Style="{StaticResource FinOverlay}" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource FinDialogCard}" Width="640" local:FinanceFocus.FocusFirstOnShow="True">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource FinField}" Width="135">
                            <TextBlock Text="DATE *" Style="{StaticResource FinLabel}"/>
                            <DatePicker SelectedDate="{Binding EditDate}" Height="30"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FinField}" Width="190">
                            <TextBlock Text="CATEGORY *" Style="{StaticResource FinLabel}"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding EditCategory}" DisplayMemberPath="Name" Height="30" IsEditable="False"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FinField}" Width="270">
                            <TextBlock Text="PAID TO (PAYEE)" Style="{StaticResource FinLabel}"/>
                            <TextBox Text="{Binding EditPayee}" Style="{StaticResource FinInput}" MaxLength="80"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FinField}" Width="135">
                            <TextBlock Text="GST RATE" Style="{StaticResource FinLabel}"/>
                            <ComboBox ItemsSource="{Binding GstRates}" SelectedItem="{Binding EditGstRate}" DisplayMemberPath="Label" Height="30"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FinField}" Width="190" Visibility="{Binding HasGst, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="PAYEE GSTIN *" Style="{StaticResource FinLabel}"/>
                            <TextBox Text="{Binding EditGstin, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FinInput}" MaxLength="15" CharacterCasing="Upper"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FinField}" Width="140" Visibility="{Binding HasGst, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="BILL NO *" Style="{StaticResource FinLabel}"/>
                            <TextBox Text="{Binding EditInvoiceNumber}" Style="{StaticResource FinInput}" MaxLength="30"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FinField}" Width="160">
                            <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource FinLabel}"/>
                            <TextBox Text="{Binding EditAmount, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FinNumberInput}"/>
                        </StackPanel>
                        <CheckBox Content="Amount includes GST" IsChecked="{Binding EditIncludesGst}" VerticalAlignment="Center" Margin="0,8,16,0"
                                  Visibility="{Binding HasGst, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Style="{StaticResource FinField}" Width="210">
                            <TextBlock Text="PAID FROM ACCOUNT *" Style="{StaticResource FinLabel}"/>
                            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding EditAccount}" DisplayMemberPath="DisplayName" Height="30"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FinField}" Width="170">
                            <TextBlock Text="MODE" Style="{StaticResource FinLabel}"/>
                            <ComboBox ItemsSource="{Binding ExpenseModes}" SelectedItem="{Binding EditMode}" DisplayMemberPath="Label" Height="30"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FinField}" Width="190">
                            <TextBlock Text="REFERENCE (UTR / TXN NO)" Style="{StaticResource FinLabel}"/>
                            <TextBox Text="{Binding EditReference}" Style="{StaticResource FinInput}" MaxLength="60"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FinField}" Width="590">
                            <TextBlock Text="DETAILS" Style="{StaticResource FinLabel}"/>
                            <TextBox Text="{Binding EditDescription}" Style="{StaticResource FinInput}" MaxLength="250">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SaveExpenseCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                    </WrapPanel>
                    <Border Style="{StaticResource FinPill}" HorizontalAlignment="Left" Margin="0,2,0,0">
                        <TextBlock Text="{Binding PreviewText}" FontWeight="SemiBold"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding DialogErrors}" Style="{StaticResource FinErrorList}"
                                  Visibility="{Binding HasDialogErrors, Converter={StaticResource BoolToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Close (Esc)" Style="{StaticResource SecondaryButton}" Command="{Binding CloseDialogsCommand}" Margin="0,0,8,0"/>
                        <Button Content="Save expense (Alt+S)" Style="{StaticResource PrimaryButton}" Command="{Binding SaveExpenseCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Cancel expense -->
        <Grid Style="{StaticResource FinOverlay}" Visibility="{Binding IsCancelDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource FinDialogCard}" Width="460" local:FinanceFocus.FocusFirstOnShow="True">
                <StackPanel>
                    <TextBlock Text="Cancel expense" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding CancelTarget}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="The expense stays in the register as cancelled (its number is kept) and its amount goes back to the account."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="REASON *" Style="{StaticResource FinLabel}"/>
                    <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FinInput}" MaxLength="250">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ConfirmCancelCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <ItemsControl ItemsSource="{Binding DialogErrors}" Style="{StaticResource FinErrorList}"
                                  Visibility="{Binding HasDialogErrors, Converter={StaticResource BoolToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Keep expense (Esc)" Style="{StaticResource SecondaryButton}" Command="{Binding CloseDialogsCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel expense" Style="{StaticResource DangerButton}" Command="{Binding ConfirmCancelCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Categories -->
        <Grid Style="{StaticResource FinOverlay}" Visibility="{Binding IsCategoriesOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource FinDialogCard}" Width="520" local:FinanceFocus.FocusFirstOnShow="True">
                <StackPanel>
                    <TextBlock Text="Expense categories" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddCategoryCommand}" Margin="8,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="NEW CATEGORY" Style="{StaticResource FinLabel}"/>
                            <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FinInput}" MaxLength="40">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddCategoryCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding AllCategories}" SelectedItem="{Binding SelectedManageCategory}" Height="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="  (hidden)" Foreground="{StaticResource TextTertiaryBrush}"
                                               Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Hide / show" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleCategoryCommand}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Rename" Style="{StaticResource SecondaryButton}" Command="{Binding RenameCategoryCommand}" Margin="8,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="RENAME SELECTED TO" Style="{StaticResource FinLabel}"/>
                            <TextBox Text="{Binding RenameCategoryText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FinInput}" MaxLength="40"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding DialogErrors}" Style="{StaticResource FinErrorList}"
                                  Visibility="{Binding HasDialogErrors, Converter={StaticResource BoolToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Done (Esc)" Style="{StaticResource SecondaryButton}" Command="{Binding CloseDialogsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

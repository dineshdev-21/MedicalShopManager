<UserControl x:Class="MedicalShopManager.App.Views.MedicinesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MedicalShopManager.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicinesViewModel}">

    <Grid>
        <!-- Main Content -->
        <DockPanel>
            <!-- Top Action & Filter Bar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Medicines Catalog" Style="{StaticResource PageTitle}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <!-- Search Input -->
                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" 
                             Height="34" 
                             VerticalContentAlignment="Center"
                             ToolTip="Search by name, composition, manufacturer, brand or barcode"
                             Margin="0,0,8,0"/>

                    <!-- Category Filter -->
                    <ComboBox Grid.Column="2" 
                              ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding SelectedCategory}" 
                              Height="34" 
                              Margin="0,0,8,0"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="🔍 Filter" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,0"/>
                        <Button Content="+ Add Medicine" Command="{Binding OpenAddModalCommand}" Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Alerts -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SuccessBgColor}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
            </Border>
            <Border DockPanel.Dock="Top" Background="{StaticResource DangerBgColor}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"/>
            </Border>

            <!-- Medicines Table -->
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <DataGrid ItemsSource="{Binding Medicines}"
                          SelectedItem="{Binding SelectedMedicine}"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Medicine Name" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Composition" Binding="{Binding Composition}" Width="1.5*"/>
                        <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="*"/>
                        <DataGridTextColumn Header="Pack" Binding="{Binding PackLabel}" Width="60"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="85"/>
                        <DataGridTextColumn Header="Rack" Binding="{Binding RackLocation}" Width="55"/>
                        <DataGridTextColumn Header="MRP (₹)" Binding="{Binding DefaultMrp, StringFormat=N2}" Width="70"/>
                        <DataGridTextColumn Header="Rate (₹)" Binding="{Binding DefaultSellingPrice, StringFormat=N2}" Width="70"/>
                        <DataGridTextColumn Header="GST %" Binding="{Binding GstRatePercent, StringFormat='{}{0}%'}" Width="55"/>
                        <DataGridTextColumn Header="HSN" Binding="{Binding HsnCode}" Width="70"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding MinStock}" Width="45"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding MaxStock}" Width="45"/>
                        <DataGridTextColumn Header="Sch" Binding="{Binding ScheduleLabel}" Width="60"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Edit" 
                                                Command="{Binding DataContext.OpenEditModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}" 
                                                Padding="8,2" 
                                                FontSize="11" 
                                                Margin="0,0,4,0"/>
                                        <Button Content="Deactivate" 
                                                Command="{Binding DataContext.DeactivateMedicineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource DangerBrush}" 
                                                FontSize="11" 
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ═══════════════ ADD / EDIT MODAL POPUP ═══════════════ -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsEditModalOpen, Converter={StaticResource BoolToVisibility}}" 
              HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch">
            <Border Style="{StaticResource CardStyle}" 
                    Width="820" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Padding="24" 
                    Background="White">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="{Binding ModalTitle}" Style="{StaticResource SectionHeader}" Margin="0"/>
                        <Button DockPanel.Dock="Right" 
                                Content="✕" 
                                Command="{Binding CloseEditModalCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                FontSize="16" 
                                Cursor="Hand" 
                                HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Form Grid (item master v2) -->
                    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Medicine Name *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,4,8">
                            <TextBlock Text="Composition / Salt" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingComposition, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,8">
                            <TextBlock Text="Manufacturer / Company" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingManufacturer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Brand" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingBrand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,8">
                            <TextBlock Text="Category" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingCategory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,8">
                            <TextBlock Text="Dosage Form" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding DosageForms}" SelectedItem="{Binding EditingDosageForm}" Height="34"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Strength (e.g. 500mg)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingStrength, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,4,8">
                            <TextBlock Text="Pack Label (e.g. 15's)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingPackLabel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="8,0,0,8">
                            <TextBlock Text="Units per Pack *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingUnitsPerPack, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="HSN Code" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingHsnCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="4,0,4,8">
                            <TextBlock Text="GST Rate %" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingGstRatePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="8,0,0,8">
                            <TextBlock Text="Drug Schedule" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding EditingSchedule}" Height="34"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="MRP per Pack (₹)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingMrp, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="4,0,4,8">
                            <TextBlock Text="Sale Rate per Pack (₹)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingSellingPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="8,0,0,8">
                            <TextBlock Text="Max Discount % (blank = no cap)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingMaxDiscountPercent, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Min Stock (units)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingMinStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="4,0,4,8">
                            <TextBlock Text="Max Stock (units, 0 = none)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingMaxStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="2" Margin="8,0,0,8">
                            <TextBlock Text="Rack / Shelf Location" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingRackLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Barcode / EAN" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding EditingBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="4,0,4,8">
                            <TextBlock Text="Status" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding EditingStatus}" Height="34"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="2" Margin="8,0,0,8">
                            <TextBlock Text="Loose Sale" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <CheckBox Content="Allow selling loose units" IsChecked="{Binding EditingAllowLooseSale}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>

                    <!-- Validation errors are shown inside the modal too (the page banner is behind the overlay) -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Modal Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseEditModalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Width="80"/>
                        <Button Content="Save Medicine" Command="{Binding SaveMedicineCommand}" Style="{StaticResource PrimaryButton}" Width="120"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
